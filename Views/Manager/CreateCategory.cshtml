@* ── Views/Manager/CreateCategory.cshtml ── *@
@model NMB_HLabSys.Models.Domain.TestCategory
@{
    ViewData["Title"] = "New Test Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>New Test Category</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-semibold"></label>
                        <input asp-for="CategoryName" class="form-control" placeholder="e.g. Full Blood Count" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description…"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
                        <a asp-action="Categories" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
