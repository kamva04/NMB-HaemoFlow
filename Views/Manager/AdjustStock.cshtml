@* ── Views/Manager/AdjustStock.cshtml ── *@
@model NMB_HLabSys.Models.ViewModels.AdjustStockViewModel
@{
    ViewData["Title"] = "Adjust Stock";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-sliders me-2"></i>Adjust Stock – @Model.ConsumableName</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info small mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Current quantity on hand: <strong>@Model.CurrentQuantity</strong>
                </div>

                <form asp-action="AdjustStock" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="ConsumableId" type="hidden" />
                    <input asp-for="ConsumableName" type="hidden" />
                    <input asp-for="CurrentQuantity" type="hidden" />

                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label asp-for="AdjustmentType" class="form-label fw-semibold">Adjustment Type</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="AdjustmentType" value="Increase" id="inc" checked />
                                <label class="form-check-label" for="inc"><i class="bi bi-plus-circle text-success me-1"></i>Increase</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="AdjustmentType" value="Decrease" id="dec" />
                                <label class="form-check-label" for="dec"><i class="bi bi-dash-circle text-danger me-1"></i>Decrease</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="AdjustmentType" value="SetTo" id="set" />
                                <label class="form-check-label" for="set"><i class="bi bi-pencil-square text-warning me-1"></i>Set To</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-semibold" id="amountLabel">Amount</label>
                        <input asp-for="Amount" type="number" min="0" class="form-control form-control-lg" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Apply</button>
                        <a asp-action="Consumables" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
