@model List<NMB_HLabSys.Models.Domain.StockProblemReport>
@{
    ViewData["Title"] = "Stock Problem Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentStatus = ViewBag.CurrentStatus as string;
    int openCount = (int)(ViewBag.OpenCount ?? 0);
    int investigatingCount = (int)(ViewBag.InvestigatingCount ?? 0);
    int resolvedCount = (int)(ViewBag.ResolvedCount ?? 0);
}

<div class="page-hero">
    <div class="page-hero-body">
        <h1 class="page-title">Stock Problem Reports</h1>
        <p class="page-subtitle">Damaged, expired or missing consumables reported by technicians.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Open</div>
            <div class="metric-value text-danger">@openCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Investigating</div>
            <div class="metric-value text-warning">@investigatingCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Resolved</div>
            <div class="metric-value text-success">@resolvedCount</div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Filter by status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="All" selected="@(string.IsNullOrWhiteSpace(currentStatus) || currentStatus == "All")">All</option>
                    <option value="Open" selected="@(currentStatus == "Open")">Open</option>
                    <option value="Investigating" selected="@(currentStatus == "Investigating")">Investigating</option>
                    <option value="Resolved" selected="@(currentStatus == "Resolved")">Resolved</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-check2-all display-5 d-block mb-3"></i>
                No stock problems match this filter.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Reported</th>
                            <th>Consumable</th>
                            <th>Issue</th>
                            <th>Technician</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var badge = r.Status switch
                            {
                                "Investigating" => "bg-warning-subtle text-warning-emphasis",
                                "Resolved"      => "bg-success-subtle text-success-emphasis",
                                _               => "bg-danger-subtle text-danger-emphasis"
                            };
                            var issueBadge = r.IssueType switch
                            {
                                "Damaged" => "bg-danger-subtle text-danger-emphasis",
                                "Expired" => "bg-warning-subtle text-warning-emphasis",
                                "Missing" => "bg-secondary-subtle text-secondary-emphasis",
                                _         => "bg-light text-dark"
                            };
                            <tr>
                                <td class="ps-4 small text-muted">@r.ReportedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td class="fw-semibold">@r.Consumable?.ConsumableName</td>
                                <td><span class="badge @issueBadge">@r.IssueType</span></td>
                                <td>
                                    @if (r.Technician != null)
                                    {
                                        <span>@r.Technician.Name @r.Technician.Surname</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small" style="max-width: 280px; white-space: pre-line;">@r.Description</td>
                                <td><span class="badge @badge">@r.Status</span></td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        @if (r.Status != "Investigating")
                                        {
                                            <button class="btn btn-outline-warning"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#statusModal"
                                                    data-report-id="@r.ReportId"
                                                    data-consumable="@r.Consumable?.ConsumableName"
                                                    data-status="Investigating">
                                                <i class="bi bi-search"></i>
                                            </button>
                                        }
                                        @if (r.Status != "Resolved")
                                        {
                                            <button class="btn btn-outline-success"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#statusModal"
                                                    data-report-id="@r.ReportId"
                                                    data-consumable="@r.Consumable?.ConsumableName"
                                                    data-status="Resolved">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                        }
                                        @if (r.Status != "Open")
                                        {
                                            <button class="btn btn-outline-secondary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#statusModal"
                                                    data-report-id="@r.ReportId"
                                                    data-consumable="@r.Consumable?.ConsumableName"
                                                    data-status="Open">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ─────── Status update modal ─────── *@
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="UpdateStockProblemStatus" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reportId" id="statusReportId" />
            <input type="hidden" name="newStatus" id="statusNewStatus" />
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-pencil-square me-2"></i>
                    Update to <span id="statusBadgeTarget" class="badge bg-primary ms-1"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">
                    Update the status of the report for
                    <strong id="statusConsumable"></strong>.
                </p>
                <label class="form-label">Manager note (optional)</label>
                <textarea name="note" rows="3" class="form-control" maxlength="500"
                          placeholder="e.g. Confirmed damaged during inspection — replacement ordered."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Update status</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.getElementById('statusModal').addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('statusReportId').value = btn.dataset.reportId;
                document.getElementById('statusNewStatus').value = btn.dataset.status;
                document.getElementById('statusConsumable').textContent = btn.dataset.consumable || '';
                document.getElementById('statusBadgeTarget').textContent = btn.dataset.status;
            });
        })();
    </script>
}