@* ── Views/Manager/CreateConsumable.cshtml ── *@
@model NMB_HLabSys.Models.Domain.Consumable
@{
    ViewData["Title"] = "Add Consumable";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add Consumable</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateConsumable" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
                    <div class="mb-3">
                        <label asp-for="ConsumableName" class="form-label fw-semibold"></label>
                        <input asp-for="ConsumableName" class="form-control" placeholder="e.g. EDTA Tubes" />
                        <span asp-validation-for="ConsumableName" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ReorderLevel" class="form-label fw-semibold"></label>
                            <input asp-for="ReorderLevel" type="number" min="0" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="QuantityOnHand" class="form-label fw-semibold"></label>
                            <input asp-for="QuantityOnHand" type="number" min="0" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="SupplierId" class="form-label fw-semibold">Supplier</label>
                        <select asp-for="SupplierId" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Suppliers as IEnumerable<NMB_HLabSys.Models.Domain.Supplier>,"SupplierId","SupplierName"))">
                            <option value="">— Select Supplier —</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
                        <a asp-action="Consumables" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
