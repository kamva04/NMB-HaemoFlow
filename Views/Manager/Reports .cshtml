@* ── Views/Manager/Reports.cshtml ── *@
@model NMB_HLabSys.Models.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Management Reports";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-file-earmark-bar-graph text-primary me-2"></i>Management Reports</h4>
    <p class="text-muted">Generate PDF reports for any date range</p>
</div>

<div class="card shadow-sm" style="max-width:540px;">
    <div class="card-header fw-semibold">
        <i class="bi bi-bar-chart me-2"></i>Tests Performed by Category
    </div>
    <div class="card-body p-4">
        <form asp-action="TestsByCategory" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FromDate" class="form-label fw-semibold"></label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                    <span asp-validation-for="FromDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ToDate" class="form-label fw-semibold"></label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                    <span asp-validation-for="ToDate" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf me-2"></i>Generate PDF
            </button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
