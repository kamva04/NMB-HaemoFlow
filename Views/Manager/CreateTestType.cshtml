@* ── Views/Manager/CreateTestType.cshtml ── *@
@model NMB_HLabSys.Models.ViewModels.TestTypeCreateViewModel
@{
    ViewData["Title"] = "New Test Type";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-clipboard2-plus me-2"></i>New Test Type</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateTestType" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="TestName" class="form-label fw-semibold"></label>
                            <input asp-for="TestName" class="form-control" placeholder="e.g. Haemoglobin" />
                            <span asp-validation-for="TestName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                            <select asp-for="CategoryId" class="form-select"
                                    asp-items="@(new SelectList(Model.Categories, "CategoryId", "CategoryName"))">
                                <option value="">— Select —</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="SampleTypeId" class="form-label fw-semibold">Sample Type</label>
                            <select asp-for="SampleTypeId" class="form-select"
                                    asp-items="@(new SelectList(Model.SampleTypes, "SampleTypeId", "TypeName"))">
                                <option value="">— Select —</option>
                            </select>
                            <span asp-validation-for="SampleTypeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Units" class="form-label fw-semibold"></label>
                            <input asp-for="Units" class="form-control" placeholder="e.g. g/dL" />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TurnaroundMinutes" class="form-label fw-semibold"></label>
                            <input asp-for="TurnaroundMinutes" type="number" class="form-control" />
                            <span asp-validation-for="TurnaroundMinutes" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NormalRangeMin" class="form-label fw-semibold"></label>
                            <input asp-for="NormalRangeMin" type="number" step="0.01" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NormalRangeMax" class="form-label fw-semibold"></label>
                            <input asp-for="NormalRangeMax" type="number" step="0.01" class="form-control" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Consumables Used</label>
                            <div class="row row-cols-2 row-cols-md-3 g-2">
                                @foreach (var c in Model.AvailableConsumables)
                                {
                                    <div class="col">
                                        <div class="form-check border rounded p-2">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedConsumableIds" value="@c.ConsumableId"
                                                   id="con_@c.ConsumableId"
                                                   @(Model.SelectedConsumableIds.Contains(c.ConsumableId) ? "checked" : "") />
                                            <label class="form-check-label small" for="con_@c.ConsumableId">
                                                @c.ConsumableName
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
                        <a asp-action="TestTypes" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
