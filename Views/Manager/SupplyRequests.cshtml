@model List<NMB_HLabSys.Models.Domain.ConsumableRequest>
@{
    ViewData["Title"] = "Supply Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentStatus = ViewBag.CurrentStatus as string;
    int pendingCount = (int)(ViewBag.PendingCount ?? 0);
    int approvedCount = (int)(ViewBag.ApprovedCount ?? 0);
    int rejectedCount = (int)(ViewBag.RejectedCount ?? 0);
}

<div class="page-hero">
    <div class="page-hero-body">
        <h1 class="page-title">Supply Requests</h1>
        <p class="page-subtitle">Review, approve, reject, or fulfil stock requests submitted by technicians.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Pending</div>
            <div class="metric-value text-warning">@pendingCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Approved / Fulfilled</div>
            <div class="metric-value text-success">@approvedCount</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-label">Rejected</div>
            <div class="metric-value text-danger">@rejectedCount</div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Filter by status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="All" selected="@(string.IsNullOrWhiteSpace(currentStatus) || currentStatus == "All")">All</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Pending</option>
                    <option value="Approved" selected="@(currentStatus == "Approved")">Approved</option>
                    <option value="PartiallyApproved" selected="@(currentStatus == "PartiallyApproved")">Partially Approved</option>
                    <option value="Fulfilled" selected="@(currentStatus == "Fulfilled")">Fulfilled</option>
                    <option value="Rejected" selected="@(currentStatus == "Rejected")">Rejected</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-clipboard-check display-5 d-block mb-3"></i>
                No supply requests match this filter.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Request #</th>
                            <th>Technician</th>
                            <th>Consumable</th>
                            <th class="text-center">Requested</th>
                            <th class="text-center">Approved</th>
                            <th>Urgency</th>
                            <th>Status</th>
                            <th>Requested</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var badge = r.Status switch
                            {
                                "Approved"           => "bg-primary-subtle text-primary-emphasis",
                                "PartiallyApproved"  => "bg-info-subtle text-info-emphasis",
                                "Rejected"           => "bg-danger-subtle text-danger-emphasis",
                                "Fulfilled"          => "bg-success-subtle text-success-emphasis",
                                "PartiallyFulfilled" => "bg-success-subtle text-success-emphasis",
                                _                    => "bg-warning-subtle text-warning-emphasis"
                            };
                            <tr>
                                <td class="ps-4 fw-semibold font-monospace">@r.RequestNumber</td>
                                <td>
                                    @if (r.Technician != null)
                                    {
                                        <span>@r.Technician.Name @r.Technician.Surname</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@r.Consumable?.ConsumableName</td>
                                <td class="text-center">@r.QuantityRequested</td>
                                <td class="text-center">@(r.QuantityApproved?.ToString() ?? "—")</td>
                                <td><span class="badge bg-light text-dark border">@r.Urgency</span></td>
                                <td><span class="badge @badge">@r.Status</span></td>
                                <td class="small text-muted">@r.RequestedAt.ToString("dd MMM HH:mm")</td>
                                <td class="text-end pe-4">
                                    @if (r.Status == "Pending")
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-success"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#approveModal"
                                                    data-request-id="@r.RequestId"
                                                    data-request-number="@r.RequestNumber"
                                                    data-requested="@r.QuantityRequested"
                                                    data-consumable="@r.Consumable?.ConsumableName">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn btn-outline-info"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#partialModal"
                                                    data-request-id="@r.RequestId"
                                                    data-request-number="@r.RequestNumber"
                                                    data-requested="@r.QuantityRequested">
                                                <i class="bi bi-sliders"></i>
                                            </button>
                                            <button class="btn btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal"
                                                    data-request-id="@r.RequestId"
                                                    data-request-number="@r.RequestNumber">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    else if (r.Status == "Approved" || r.Status == "PartiallyApproved")
                                    {
                                        <form asp-action="FulfillSupplyRequest" method="post" class="d-inline"
                                              onsubmit="return confirm('Mark @r.RequestNumber as fulfilled?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@r.RequestId" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-box-arrow-down me-1"></i>Fulfil
                                            </button>
                                        </form>
                                    }
                                    else if (r.Status == "Fulfilled")
                                    {
                                        <span class="text-success small">
                                            <i class="bi bi-check-circle me-1"></i>Done
                                        </span>
                                    }
                                    else if (r.Status == "Rejected")
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled
                                                title="@r.ManagerDecisionNote">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ─────── Approve modal ─────── *@
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="ApproveSupplyRequest" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" id="approveRequestId" />
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-check-circle text-success me-2"></i>Approve request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">
                    Approving <strong id="approveRequestNumber"></strong> will authorise
                    <strong id="approveQuantity"></strong> unit(s) of <strong id="approveConsumable"></strong>.
                </p>
                <p class="small text-warning mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Stock is <strong>not</strong> changed by approval — use Adjust Stock to issue stock.
                </p>
                <label class="form-label">Decision note (optional)</label>
                <textarea name="decisionNote" rows="2" class="form-control" maxlength="500"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success">Approve</button>
            </div>
        </form>
    </div>
</div>

@* ─────── Partial approve modal ─────── *@
<div class="modal fade" id="partialModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="PartiallyApproveSupplyRequest" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" id="partialRequestId" />
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-sliders text-info me-2"></i>Partially approve</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">
                    Request <strong id="partialRequestNumber"></strong> — requested
                    <strong id="partialRequested"></strong> unit(s).
                </p>
                <label class="form-label">Quantity to approve</label>
                <input type="number" name="quantityApproved" id="partialQuantity"
                       class="form-control mb-2" min="1" required />
                <label class="form-label">Decision note (optional)</label>
                <textarea name="decisionNote" rows="2" class="form-control" maxlength="500"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-info">Partially approve</button>
            </div>
        </form>
    </div>
</div>

@* ─────── Reject modal ─────── *@
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="RejectSupplyRequest" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" id="rejectRequestId" />
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-x-octagon text-danger me-2"></i>Reject request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">
                    Rejecting <strong id="rejectRequestNumber"></strong> will notify the technician.
                </p>
                <label class="form-label">Reason <span class="text-danger">*</span></label>
                <textarea name="reason" rows="3" class="form-control" maxlength="500" required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">Reject request</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // Approve
            document.getElementById('approveModal').addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('approveRequestId').value = btn.dataset.requestId;
                document.getElementById('approveRequestNumber').textContent = btn.dataset.requestNumber;
                document.getElementById('approveQuantity').textContent = btn.dataset.requested;
                document.getElementById('approveConsumable').textContent = btn.dataset.consumable || '';
            });

            // Partial
            document.getElementById('partialModal').addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('partialRequestId').value = btn.dataset.requestId;
                document.getElementById('partialRequestNumber').textContent = btn.dataset.requestNumber;
                document.getElementById('partialRequested').textContent = btn.dataset.requested;
                var qty = document.getElementById('partialQuantity');
                qty.value = btn.dataset.requested;
                qty.max = btn.dataset.requested;
            });

            // Reject
            document.getElementById('rejectModal').addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                document.getElementById('rejectRequestId').value = btn.dataset.requestId;
                document.getElementById('rejectRequestNumber').textContent = btn.dataset.requestNumber;
            });
        })();
    </script>
}