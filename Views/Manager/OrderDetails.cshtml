@* ── Views/Manager/OrderDetails.cshtml ── *@
@model NMB_HLabSys.Models.Domain.StockOrder
@{
    ViewData["Title"] = "Order Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-receipt text-primary me-2"></i>Order @Model.OrderNumber</h4>
        <p class="text-muted mb-0">Supplier: @Model.Supplier?.SupplierName &nbsp;|&nbsp; Date: @Model.OrderDate.ToString("dd MMM yyyy")</p>
    </div>
    <span class="badge fs-6
        @(Model.Status == "Complete" ? "bg-success" :
          Model.Status == "PartiallyComplete" ? "bg-warning text-dark" :
          Model.Status == "Cancelled" ? "bg-danger" : "bg-primary")">
        @Model.Status
    </span>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Consumable</th>
                    <th class="text-center">Qty Ordered</th>
                    <th class="text-center">Status</th>
                    <th>Date Received</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Consumable?.ConsumableName</td>
                        <td class="text-center">@item.QuantityOrdered</td>
                        <td class="text-center">
                            <span class="badge
                                @(item.Status == "Received" ? "bg-success" :
                                  item.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                @item.Status
                            </span>
                        </td>
                        <td>@(item.DateReceived?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td class="text-end">
                            @if (item.Status == "Ordered")
                            {
                                <form asp-action="ReceiveOrderItem" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderItemId" value="@item.OrderItemId" />
                                    <button type="submit" class="btn btn-sm btn-success"
                                            onclick="return confirm('Mark this item as received?')">
                                        <i class="bi bi-check-circle me-1"></i>Receive
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Orders" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Orders
    </a>
</div>
