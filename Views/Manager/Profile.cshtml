@model NMB_HLabSys.Models.ViewModels.ManagerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var editing = !ViewData.ModelState.IsValid;
    var initials = string.Concat(Model.Name?.FirstOrDefault(), Model.Surname?.FirstOrDefault()).Trim().ToUpperInvariant();
}

<div class="manager-profile">
    <div class="profile-page-heading">
        <h1>My Profile</h1>
        <p>Manage your personal details and account security.</p>
    </div>

    <header class="profile-banner">
        <div class="manager-avatar" aria-hidden="true">@initials</div>
        <div class="profile-identity">
            <span class="profile-role">Laboratory Manager</span>
            <h2>@Model.Name @Model.Surname</h2>
            <p>@Model.Email</p>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="profile-panel" aria-labelledby="personal-title">
                <div class="profile-panel-heading">
                    <div>
                        <h2 id="personal-title">Personal Details</h2>
                        <p>Your name as it appears in the system.</p>
                    </div>
                    <button class="btn btn-outline-primary profile-edit" type="button" data-bs-toggle="collapse" data-bs-target="#profile-editor" aria-expanded="@(editing ? "true" : "false")" aria-controls="profile-editor">
                        <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Edit Profile
                    </button>
                </div>
                <dl class="profile-details">
                    <div><dt>First name</dt><dd>@Model.Name</dd></div>
                    <div><dt>Surname</dt><dd>@Model.Surname</dd></div>
                </dl>
                <div id="profile-editor" class="collapse @(editing ? "show" : "")">
                    <form asp-action="Profile" method="post" class="profile-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Surname" class="form-label fw-semibold"></label>
                                <input asp-for="Surname" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="Surname" class="text-danger small"></span>
                            </div>
                        </div>
                        <input asp-for="Email" type="hidden" />
                        <div class="mt-4 d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="profile-panel" aria-labelledby="security-title">
                <div class="profile-panel-heading">
                    <div>
                        <h2 id="security-title">Account &amp; Security</h2>
                        <p>Manage how you sign in.</p>
                    </div>
                </div>
                <div class="profile-security-item">
                    <span class="profile-security-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                    <div>
                        <h3>Email / username</h3>
                        <p>@Model.Email</p>
                        <a asp-controller="Account" asp-action="ChangeEmail">Change Email <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
                <div class="profile-security-item">
                    <span class="profile-security-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                    <div>
                        <h3>Password</h3>
                        <p>Update your password to keep your account secure.</p>
                        <a asp-controller="Account" asp-action="ChangePassword">Change Password <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Styles {
<style>
    .manager-profile { max-width:1100px; margin:0 auto; color:#193b56; }
    .profile-page-heading { margin-bottom:24px; }
    .profile-page-heading h1 { color:#0d3b66; font-size:1.7rem; font-weight:750; margin-bottom:6px; }
    .profile-page-heading p { color:#607589; margin:0; }
    .profile-banner { display:flex; align-items:center; gap:24px; padding:30px; margin-bottom:24px; border-radius:18px; background:linear-gradient(120deg,#0d3b66,#15588a); color:#fff; }
    .manager-avatar { flex:0 0 80px; height:80px; display:grid; place-items:center; border-radius:50%; background:#e4f1fc; color:#0d3b66; font-size:1.7rem; font-weight:750; border:4px solid rgba(255,255,255,.25); }
    .profile-identity { min-width:0; }
    .profile-role { font-size:.75rem; font-weight:650; color:#d6edff; letter-spacing:.035em; }
    .profile-identity h2 { font-size:1.55rem; font-weight:700; margin:8px 0; overflow-wrap:anywhere; }
    .profile-identity p { color:#d6e8f6; margin:0; overflow-wrap:anywhere; }
    .profile-panel { background:#fff; border:1px solid #dce7f0; border-radius:16px; padding:28px; box-shadow:0 4px 18px rgba(13,59,102,.04); }
    .profile-panel-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap; }
    .profile-panel-heading h2 { font-size:1.1rem; font-weight:700; color:#0d3b66; margin-bottom:6px; }
    .profile-panel-heading p { color:#607589; font-size:.9rem; margin:0; }
    .profile-edit { font-size:.85rem; white-space:nowrap; }
    .profile-details { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; padding-top:28px; margin:0; }
    .profile-details dt { font-size:.8rem; color:#607589; font-weight:500; margin-bottom:8px; }
    .profile-details dd { font-weight:600; margin:0; overflow-wrap:anywhere; }
    .profile-form { margin-top:26px; padding-top:24px; border-top:1px solid #e3edf5; }
    .manager-profile .validation-summary-valid { display:none; }
    .profile-security-item { display:flex; gap:14px; margin-top:24px; }
    .profile-security-item + .profile-security-item { border-top:1px solid #e3edf5; padding-top:24px; }
    .profile-security-icon { flex:0 0 40px; height:40px; display:grid; place-items:center; background:#edf5fc; border-radius:10px; color:#0d3b66; }
    .profile-security-item > div { min-width:0; }
    .profile-security-item h3 { font-size:.95rem; font-weight:650; margin-bottom:6px; }
    .profile-security-item p { font-size:.88rem; color:#607589; margin-bottom:10px; overflow-wrap:anywhere; }
    .profile-security-item a { color:#12618d; font-size:.88rem; font-weight:600; text-underline-offset:3px; }
    .manager-profile .btn-primary { background:#0d3b66; border-color:#0d3b66; }
    .manager-profile .btn-primary:hover { background:#092d4e; }
    .manager-profile .btn-outline-primary { color:#0d3b66; border-color:#99bdd9; }
    .manager-profile .btn-outline-primary:hover { background:#e7f2fb; }
    @@media(max-width:575.98px) { .profile-banner { padding:22px; gap:16px; flex-wrap:wrap; } .profile-panel { padding:22px; } .profile-details { grid-template-columns:1fr; gap:18px; } }
</style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
