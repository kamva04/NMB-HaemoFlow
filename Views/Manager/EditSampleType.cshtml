@model NMB_HLabSys.Models.Domain.SampleType
@{ ViewData["Title"] = "Edit Sample Type"; }
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white py-3"><h1 class="h5 mb-0">Edit Sample Type</h1></div>
            <div class="card-body p-4">
                <form asp-action="EditSampleType" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="SampleTypeId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                    <div class="mb-4">
                        <label asp-for="TypeName" class="form-label fw-semibold">Sample type name</label>
                        <input asp-for="TypeName" class="form-control" placeholder="e.g. Whole Blood" />
                        <span asp-validation-for="TypeName" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-action="SampleTypes" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
