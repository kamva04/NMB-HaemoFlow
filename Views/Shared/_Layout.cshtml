@using Microsoft.AspNetCore.Http
@{
    var sessionUserId = Context.Session.GetInt32("UserId");
    var sessionEmail = Context.Session.GetString("Email") ?? string.Empty;
    var sessionRole = Context.Session.GetString("Role") ?? string.Empty;
    bool isLoggedIn = sessionUserId.HasValue;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – NMB-HLabSys</title>
    <link rel="icon" type="image/jpeg" href="~/images/nmb-hlabsys-logo.jpg" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --nmb-primary: #0d3b66;
            --nmb-accent: #1a8fe3;
            --sidebar-blue: #073b82;
            --sidebar-blue-dark: #042a5e;
        }

        html, body {
            height: 100%;
        }

        body {
            background: #f4f7fb;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── Navbar ── */
        .navbar {
            background: var(--nmb-primary) !important;
        }

        .navbar-brand, .nav-link, .navbar-text {
            color: #fff !important;
        }

            .nav-link:hover {
                color: var(--nmb-accent) !important;
            }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        /* ── Notification bell ── */
        #notifBell .badge {
            animation: notifPulse 2s infinite;
        }
       @("@") keyframes notifPulse {
            0%, 100%

        {
            transform: translate(-50%, -50%) scale(1);
        }

        50% {
            transform: translate(-50%, -50%) scale(1.15);
        }

        }

        .notif-toast-custom {
            position: fixed;
            top: 70px;
            right: 20px;
            z-index: 9998;
            max-width: 380px;
        }

        /* ── Sidebar ── */
        #appSidebar {
            width: 230px;
            min-width: 230px;
            min-height: calc(100vh - 56px);
            background: linear-gradient(180deg, var(--sidebar-blue) 0%, var(--sidebar-blue-dark) 100%);
            border-right: 0;
            padding: 1rem .75rem;
            flex-shrink: 0;
        }

            #appSidebar .nav-link {
                color: rgba(255,255,255,.9);
                border-radius: .375rem;
                margin-bottom: .15rem;
                padding: .45rem .75rem;
                font-size: .92rem;
            }

                #appSidebar .nav-link:hover,
                #appSidebar .nav-link.active {
                    background: #0d6efd;
                    color: #fff !important;
                }

            #appSidebar hr {
                margin: .5rem 0;
                border-color: #dee2e6;
            }

            #appSidebar .sidebar-heading {
                font-size: .7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .07em;
                color: rgba(255,255,255,.62);
                padding: .5rem .75rem .25rem;
            }

            #appSidebar.manager-sidebar {
                background: linear-gradient(180deg, var(--sidebar-blue) 0%, var(--sidebar-blue-dark) 100%);
                border-right: 0;
            }

                #appSidebar.manager-sidebar .nav-link {
                    color: rgba(255,255,255,.88);
                }

                    #appSidebar.manager-sidebar .nav-link:hover,
                    #appSidebar.manager-sidebar .nav-link.active {
                        background: rgba(255,255,255,.2);
                        color: #fff !important;
                    }

                #appSidebar.manager-sidebar .sidebar-heading {
                    color: rgba(255,255,255,.65);
                }

        /* ── Page wrapper ── */
        #pageWrapper {
            display: flex;
            flex: 1;
        }

        #mainContent {
            flex: 1;
            padding: 2rem;
            overflow-x: auto;
        }

        /* ── Cards ── */
        .card {
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }

        /* ── Urgency badges ── */
        .badge-stat {
            background: #dc3545 !important;
            color: #fff;
        }

        .badge-urgent {
            background: #fd7e14 !important;
            color: #fff;
        }

        .badge-routine {
            background: #198754 !important;
            color: #fff;
        }

        /* ── Abnormal row highlight ── */
        .alert-abnormal {
            background: #fff3cd !important;
            border-left: 4px solid #ffc107;
        }

        /* ── Footer ── */
        footer {
            background: var(--nmb-primary);
            color: #adb5bd;
            font-size: .83rem;
            padding: .9rem 0;
            margin-top: auto;
        }

        /* ── Mobile sidebar toggle ── */
        #sidebarToggle {
            display: none;
        }
        @("@") media (max-width: 991.98px) {
            #sidebarToggle

        {
            display: inline-flex;
        }

        #appSidebar {
            position: fixed;
            top: 56px;
            left: -240px;
            height: 100%;
            z-index: 1050;
            transition: left .25s ease;
            box-shadow: 4px 0 12px rgba(0,0,0,.15);
        }

            #appSidebar.open {
                left: 0;
            }

        #sidebarBackdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.35);
            z-index: 1049;
        }

            #sidebarBackdrop.open {
                display: block;
            }

        .notif-toast-custom {
            top: 60px;
            right: 10px;
            left: 10px;
            max-width: none;
        }

        }

        .tech-profile-card {
            text-align: center;
            padding: 14px 10px 18px;
            margin-bottom: 6px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }

        .tech-avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,0.35);
            box-shadow: 0 4px 14px rgba(0,0,0,0.35);
            margin-bottom: 10px;
            background: rgba(255,255,255,0.15);
        }

        .tech-avatar-placeholder {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.7);
            font-size: 2rem;
        }

        .tech-name {
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            line-height: 1.2;
            margin-bottom: 4px;
        }

        .tech-employee {
            color: rgba(255,255,255,0.75);
            font-size: 0.78rem;
            font-family: 'Courier New', monospace;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["IsLandingPage"] as bool? == true ? "landing-page" : string.Empty)">

    <!-- ── TOP NAVBAR ─────────────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container-fluid px-3">

            @if (isLoggedIn)
            {
                <button id="sidebarToggle" class="btn btn-sm btn-outline-light me-2"
                        type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-layout-sidebar"></i>
                </button>
            }

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <img src="~/images/nmb-hlabsys-logo.jpg" asp-append-version="true" alt="" width="44" height="44" class="me-2" style="object-fit:contain;background:#fff;border-radius:8px;padding:3px;" />NMB-HLabSys
            </a>

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#topNav" aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-three-dots-vertical text-white fs-5"></i>
            </button>

            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav ms-auto align-items-center gap-1">

                    @if (isLoggedIn)
                    {
                        @* ── Notification bell (partial) ── *@
                        <partial name="_NotificationBell" />

                        <li class="nav-item">
                            <span class="navbar-text small">
                                <i class="bi bi-person-circle me-1"></i>@sessionEmail
                                <span class="badge bg-secondary ms-1">@sessionRole</span>
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-2" asp-controller="Account" asp-action="ChangePassword"
                               title="Change Password">
                                <i class="bi bi-key me-1"></i><span class="d-lg-none">Password</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link py-1 px-2" asp-controller="Account" asp-action="ChangeEmail"
                               title="Change Email">
                                <i class="bi bi-envelope me-1"></i><span class="d-lg-none">Email</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-light">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        @if (ViewData["IsLandingPage"] as bool? == true)
                        {
                            <li class="nav-item"><a class="nav-link" href="#about">About us</a></li>
                            <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                            <li class="nav-item"><a class="nav-link" href="#roles">Who it's for</a></li>
                            <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ── SIDEBAR BACKDROP (mobile) ─────────────────────────────── -->
    @if (isLoggedIn)
    {
        <div id="sidebarBackdrop"></div>
    }

    <!-- ── PAGE WRAPPER ───────────────────────────────────────────── -->
    <div id="pageWrapper">

        @if (isLoggedIn)
        {
            <div id="appSidebar" class="@(sessionRole == "Manager" ? "manager-sidebar" : string.Empty)">
                @await Html.PartialAsync("~/Views/Shared/_Sidebar.cshtml")
            </div>
        }

        <div id="mainContent">
            @RenderBody()
        </div>

    </div>

    <!-- ── TEMPDATA TOASTS ─────────────────────────────────────────── -->
    @if (TempData["Success"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999">
            <div class="toast show align-items-center text-bg-success border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999">
            <div class="toast show align-items-center text-bg-danger border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <!-- ── NOTIFICATION TOAST CONTAINER (populated by JS) ──────────── -->
    <div id="notifToastContainer"></div>

    <!-- ── FOOTER ─────────────────────────────────────────────────── -->
    <footer class="text-center">
        <div class="container">
            <p class="mb-0">
                &copy; @DateTime.Now.Year
                Nelson Mandela Bay Haematology Diagnostic Laboratories &nbsp;|&nbsp; NMB-HLabSys
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ── Mobile sidebar toggle ────────────────────────────────────
        const toggleBtn  = document.getElementById('sidebarToggle');
        const sidebar    = document.getElementById('appSidebar');
        const backdrop   = document.getElementById('sidebarBackdrop');

        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('open');
                backdrop.classList.toggle('open');
            });
            backdrop.addEventListener('click', () => {
                sidebar.classList.remove('open');
                backdrop.classList.remove('open');
            });
        }

        // ── Auto-dismiss TempData toasts after 4 s ────────────────
        document.querySelectorAll('.toast').forEach(el => {
            setTimeout(() => {
                el.classList.remove('show');
                el.style.display = 'none';
            }, 4000);
        });

        // ── Mark active sidebar link ──────────────────────────────
        const currentPath = window.location.pathname.toLowerCase();
        document.querySelectorAll('#appSidebar .nav-link').forEach(link => {
            const href = link.getAttribute('href');
            if (href && currentPath.startsWith(href.toLowerCase()) && href !== '/') {
                link.classList.add('active');
            }
        });
    </script>

    @if (isLoggedIn)
    {
        <script>
            (function () {
                var badgeUrl = '@Url.Action("GetUnreadCount", "Notifications")';
                var badge = document.getElementById('notifBadge');
                var items = document.getElementById('notifItems');
                var loading = document.getElementById('notifLoading');
                var empty = document.getElementById('notifEmpty');
                var toastContainer = document.getElementById('notifToastContainer');

                var lastCount = null;
                var toastedIds = {};

                function escapeHtml(s) {
                    if (!s) return '';
                    return String(s)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                function renderBadge(data) {
                    if (!badge) return;
                    if (data.count > 0) {
                        badge.textContent = data.count > 99 ? '99+' : data.count;
                        badge.classList.remove('d-none');
                    } else {
                        badge.classList.add('d-none');
                    }
                }

                function renderDropdown(data) {
                    if (!items || !loading || !empty) return;
                    loading.classList.add('d-none');
                    items.innerHTML = '';

                    if (!data.latest || data.latest.length === 0) {
                        empty.classList.remove('d-none');
                        return;
                    }

                    empty.classList.add('d-none');
                    data.latest.forEach(function (n) {
                        var icon = n.category === 'Overdue' ? 'bi-exclamation-octagon-fill text-danger'
                                 : n.category === 'NearDue' ? 'bi-alarm-fill text-warning'
                                 : n.category === 'Stock'   ? 'bi-box-seam-fill text-info'
                                 : n.category === 'STAT'    ? 'bi-lightning-charge-fill text-danger'
                                 : 'bi-info-circle-fill text-secondary';

                        var li = document.createElement('li');
                        li.innerHTML =
                            '<a class="dropdown-item d-flex gap-2 py-2" href="/Notifications">' +
                                '<i class="bi ' + icon + ' fs-5"></i>' +
                                '<div class="flex-grow-1">' +
                                    '<div class="small fw-semibold">' + escapeHtml(n.title) + '</div>' +
                                    '<div class="small text-muted">' + escapeHtml(n.createdAt) + '</div>' +
                                '</div>' +
                            '</a>';
                        items.appendChild(li);
                    });

                    var footer = document.createElement('li');
                    footer.innerHTML =
                        '<hr class="dropdown-divider" />' +
                        '<a class="dropdown-item text-center small text-primary" href="/Notifications">View all notifications</a>';
                    items.appendChild(footer);
                }

                function showToast(n) {
                    if (!toastContainer) return;
                    if (toastedIds[n.id]) return;
                    toastedIds[n.id] = true;

                    var icon = n.category === 'Overdue' ? 'bi-exclamation-octagon-fill'
                             : n.category === 'NearDue' ? 'bi-alarm-fill'
                             : n.category === 'Stock'   ? 'bi-box-seam-fill'
                             : n.category === 'STAT'    ? 'bi-lightning-charge-fill'
                             : 'bi-info-circle-fill';

                    var toast = document.createElement('div');
                    toast.className = 'toast show align-items-center text-bg-primary border-0 notif-toast-custom mb-2';
                    toast.setAttribute('role', 'alert');
                    toast.innerHTML =
                        '<div class="d-flex">' +
                            '<div class="toast-body">' +
                                '<i class="bi ' + icon + ' me-2"></i>' +
                                '<strong>' + escapeHtml(n.title) + '</strong>' +
                            '</div>' +
                            '<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>' +
                        '</div>';
                    toastContainer.appendChild(toast);

                    setTimeout(function () {
                        toast.classList.remove('show');
                        setTimeout(function () { toast.remove(); }, 500);
                    }, 6000);
                }

                function poll() {
                    fetch(badgeUrl, { credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            renderBadge(data);
                            renderDropdown(data);

                            if (lastCount !== null && data.count > lastCount && data.latest) {
                                data.latest.slice(0, 2).forEach(showToast);
                            }
                            lastCount = data.count;
                        })
                        .catch(function () { /* silent */ });
                }

                poll();
                setInterval(poll, 30000);

                var bell = document.getElementById('notifBell');
                if (bell) {
                    bell.addEventListener('click', poll);
                }
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>