@* ── Views/Account/AccessDenied.cshtml ── *@
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center">
    <div class="text-center py-5">
        <i class="bi bi-shield-x display-1 text-danger"></i>
        <h2 class="fw-bold mt-3">Access Denied</h2>
        <p class="text-muted">You don't have permission to view this page.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-2">
            <i class="bi bi-house me-1"></i>Go to Login
        </a>
    </div>
</div>
