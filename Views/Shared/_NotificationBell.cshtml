@using Microsoft.AspNetCore.Http
@{
    var bellUserId = Context.Session.GetInt32("UserId");
    bool bellIsLoggedIn = bellUserId.HasValue;
}

@if (bellIsLoggedIn)
{
    <li class="nav-item dropdown me-1">
        <a class="nav-link position-relative py-1 px-2" href="#" id="notifBell" role="button"
           data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
            <i class="bi bi-bell fs-5"></i>
            <span id="notifBadge"
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                  style="font-size: 0.6rem;">
                0
            </span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="notifBell"
            style="min-width: 340px; max-width: 380px;" id="notifDropdown">
            <li class="dropdown-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Notifications</span>
                <a asp-controller="Notifications" asp-action="Index" class="small text-decoration-none">
                    View all
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li id="notifLoading" class="text-center py-3 small text-muted">
                <div class="spinner-border spinner-border-sm me-1" role="status"></div>Loading…
            </li>
            <li id="notifEmpty" class="text-center py-3 small text-muted d-none">
                <i class="bi bi-bell-slash d-block mb-1 fs-4"></i>
                No unread notifications
            </li>
            <li id="notifItems"></li>
        </ul>
    </li>
}