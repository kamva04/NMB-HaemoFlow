        <a class="nav-link @active("/manager/supplyrequests")" asp-controller="Manager" asp-action="SupplyRequests">
            <i class="bi bi-cart-check me-2"></i>Supply Requests
        </a>
        <a class="nav-link @active("/manager/stockproblems")" asp-controller="Manager" asp-action="StockProblems">
            <i class="bi bi-exclamation-triangle me-2"></i>Stock Problems
        </a>

        <div class="sidebar-heading mt-2">Test Management</div>
        <a class="nav-link @active("/manager/categories")" asp-controller="Manager" asp-action="Categories">
            <i class="bi bi-tags me-2"></i>Test Categories
        </a>
        <a class="nav-link @active("/manager/testtypes")" asp-controller="Manager" asp-action="TestTypes">
            <i class="bi bi-clipboard2-pulse me-2"></i>Test Types
        </a>
        <a class="nav-link @active("/manager/sampletypes")" asp-controller="Manager" asp-action="SampleTypes">
            <i class="bi bi-droplet-half me-2"></i>Sample Types
        </a>

        <div class="sidebar-heading mt-2">Stock</div>
        <a class="nav-link @active("/manager/consumables")" asp-controller="Manager" asp-action="Consumables">
            <i class="bi bi-box-seam me-2"></i>Consumables
        </a>
        <a class="nav-link @active("/manager/suppliers")" asp-controller="Manager" asp-action="Suppliers">
            <i class="bi bi-truck me-2"></i>Suppliers
        </a>
        <a class="nav-link @active("/manager/orders")" asp-controller="Manager" asp-action="Orders">
            <i class="bi bi-cart3 me-2"></i>Stock Orders
        </a>

        <div class="sidebar-heading mt-2">Users</div>
        <a class="nav-link @active("/manager/doctors")" asp-controller="Manager" asp-action="Doctors">
            <i class="bi bi-person-badge me-2"></i>Doctors
        </a>
        <a class="nav-link @active("/manager/technicians")" asp-controller="Manager" asp-action="Technicians">
            <i class="bi bi-person-gear me-2"></i>Technicians
        </a>

        <div class="sidebar-heading mt-2">Other</div>
        <a class="nav-link @active("/manager/reports")" asp-controller="Manager" asp-action="Reports">
            <i class="bi bi-file-earmark-bar-graph me-2"></i>Reports
        </a>
        <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">
            <i class="bi bi-key me-2"></i>Change Password
        </a>
        <a class="nav-link" asp-controller="Account" asp-action="ChangeEmail">
            <i class="bi bi-envelope me-2"></i>Change Email
        </a>
    </nav>
}
