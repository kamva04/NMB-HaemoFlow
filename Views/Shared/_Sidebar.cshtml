@using Microsoft.AspNetCore.Http
@using NMB_HLabSys.Data
@using Microsoft.EntityFrameworkCore
@using System.Linq
@inject ApplicationDbContext Db

@{
    var role = Context.Session.GetString("Role") ?? string.Empty;
    var currentPath = Context.Request.Path.Value?.ToLower() ?? string.Empty;
    Func<string, string> active = (path) =>
        currentPath.Contains(path.ToLower()) ? "active" : string.Empty;

    // Technician profile card data
    string? techFullName = null;
    string? techEmployeeNumber = null;
    string? techProfilePicture = null;

    if (role == "Technician")
    {
        var techUserId = Context.Session.GetInt32("UserId");
        if (techUserId.HasValue)
        {
            var tech = Db.Technicians
                .AsNoTracking()
                .Where(t => t.UserId == techUserId.Value)
                .Select(t => new { t.Name, t.Surname, t.EmployeeNumber, t.ProfilePicturePath })
                .FirstOrDefault();

            if (tech != null)
            {
                techFullName = tech.Name + " " + tech.Surname;
                techEmployeeNumber = tech.EmployeeNumber;
                techProfilePicture = tech.ProfilePicturePath;
            }
        }
    }
}

@if (role == "Manager")
{
    <div class="sidebar-heading">Manager</div>
    <nav class="nav flex-column">
        <a class="nav-link @active("/manager/index")" asp-controller="Manager" asp-action="Index">
