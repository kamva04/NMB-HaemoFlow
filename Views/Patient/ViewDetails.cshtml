@model NMB_HLabSys.Models.Domain.TestRequest
@{
    ViewData["Title"] = "Test Request Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-clipboard2-pulse text-primary me-2"></i>@Model.RequestNumber
        </h4>
        <p class="text-muted mb-0">
            Submitted @Model.RequestDate.ToString("dd MMM yyyy HH:mm")
            · @Model.Urgency
        </p>
    </div>
    <span class="badge fs-6 @(Model.Status == "ReleasedByDoctor" ? "bg-success" :
        Model.Status == "Cancelled" ? "bg-danger" :
        Model.Status == "InProgress" ? "bg-primary" :
        Model.Status == "SamplesReceived" ? "bg-info text-dark" : "bg-secondary")">
        @NMB_HLabSys.Helpers.StatusDisplay.Format(Model.Status)
    </span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ClinicalNotes))
{
    <div class="alert alert-light border">
        <strong>Clinical notes:</strong> @Model.ClinicalNotes
    </div>
}

<div class="card">
    <div class="card-header fw-semibold">Requested Tests</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr><th>Test</th><th>Category</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var test in Model.RequestTestTypes)
                {
                    <tr>
                        <td class="fw-semibold">@test.TestType?.TestName</td>
                        <td class="text-muted">@test.TestType?.Category?.CategoryName</td>
                        <td>
                            <span class="badge @(test.Status == "Verified" ? "bg-success" :
                                test.Status == "Completed" ? "bg-info text-dark" :
                                test.Status == "InProgress" ? "bg-primary" :
                                test.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                @NMB_HLabSys.Helpers.StatusDisplay.Format(test.Status)
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    @if (Model.Status == "ReleasedByDoctor")
    {
        <a asp-action="ViewResults" asp-route-requestId="@Model.RequestId" class="btn btn-success">
            <i class="bi bi-file-medical me-1"></i>View Results
        </a>
        <a asp-controller="Report" asp-action="PatientRequestPdf"
           asp-route-requestId="@Model.RequestId" class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
        </a>
    }
    <a asp-action="MyRequests" class="btn btn-outline-secondary">Back to Requests</a>
</div>
