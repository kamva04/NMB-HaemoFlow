@model NMB_HLabSys.Models.Domain.Patient

@{
    ViewData["Title"] = "Health Tracking";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Health Tracking - NMB-HLabSys</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: #f5f7fb;
            font-family: Arial, sans-serif;
        }

        .health-header {
            background: white;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .health-card {
            background: white;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .metric-card {
            border-radius: 14px;
            padding: 20px;
            background: white;
            box-shadow: 0 3px 12px rgba(0,0,0,0.05);
            height: 100%;
        }

        .metric-title {
            font-size: 14px;
            color: #777;
            margin-bottom: 8px;
        }

        .metric-value {
            font-size: 27px;
            font-weight: bold;
        }

        .metric-icon {
            font-size: 28px;
        }

        .section-title {
            font-weight: 600;
            margin-bottom: 18px;
        }

        .status-normal {
            color: #198754;
            font-weight: 600;
        }

        .status-warning {
            color: #fd7e14;
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 35px;
            color: #777;
        }

        .table-card {
            overflow-x: auto;
        }

        .delete-btn {
            border: none;
            background: transparent;
            color: #dc3545;
        }

            .delete-btn:hover {
                color: #a71d2a;
            }

        .health-summary {
            background: #eef6ff;
            border-radius: 14px;
            padding: 20px;
        }
    </style>
</head>

<body>

    <div class="container py-4">

        <!-- HEADER -->
        <div class="health-header d-flex justify-content-between align-items-center">

            <div>
                <h2 class="mb-1">Health Tracking</h2>

                <p class="text-muted mb-0">
                    Monitor your health information and daily wellness.
                </p>

                @if (Model != null)
                {
                    <small class="text-muted">
                        Patient: <strong>@Model.Name @Model.Surname</strong>
                    </small>
                }
            </div>

            <div>
                <a asp-controller="Patient"
                   asp-action="Dashboard"
                   class="btn btn-outline-secondary">
                    Back to Dashboard
                </a>
            </div>

        </div>


        <!-- HEALTH SUMMARY -->
        <div class="health-card">

            <h5 class="section-title">
                Today's Health Summary
            </h5>

            <div class="row g-3">

                <div class="col-md-3">
                    <div class="metric-card">

                        <div class="metric-title">
                            Latest Weight
                        </div>

                        <div class="metric-value">
                            <span id="latestWeight">--</span>
                            <small class="fs-6">kg</small>
                        </div>

                    </div>
                </div>


                <div class="col-md-3">
                    <div class="metric-card">

                        <div class="metric-title">
                            Blood Pressure
                        </div>

                        <div class="metric-value">
                            <span id="latestBloodPressure">--</span>
                        </div>

                    </div>
                </div>


                <div class="col-md-3">
                    <div class="metric-card">

                        <div class="metric-title">
                            Heart Rate
                        </div>

                        <div class="metric-value">
                            <span id="latestHeartRate">--</span>
                            <small class="fs-6">bpm</small>
                        </div>

                    </div>
                </div>


                <div class="col-md-3">
                    <div class="metric-card">

                        <div class="metric-title">
                            Mood
                        </div>

                        <div class="metric-value">
                            <span id="latestMood">--</span>
                        </div>

                    </div>
                </div>

            </div>

        </div>


        <!-- ADD HEALTH ENTRY -->
        <div class="health-card">

            <h5 class="section-title">
                Record Health Information
            </h5>

            <form id="healthForm">

                <div class="row g-3">

                    <!-- DATE -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Date
                        </label>

                        <input type="date"
                               class="form-control"
                               id="healthDate"
                               required>

                    </div>


                    <!-- WEIGHT -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Weight (kg)
                        </label>

                        <input type="number"
                               class="form-control"
                               id="weight"
                               step="0.1"
                               min="0"
                               placeholder="e.g. 70.5">

                    </div>


                    <!-- HEART RATE -->
                    <div class="col-md-4">

                        <label class="form-label">
                            Heart Rate (bpm)
                        </label>

                        <input type="number"
                               class="form-control"
                               id="heartRate"
                               min="0"
                               placeholder="e.g. 72">

                    </div>


                    <!-- BLOOD PRESSURE -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Blood Pressure
                        </label>

                        <input type="text"
                               class="form-control"
                               id="bloodPressure"
                               placeholder="e.g. 120/80">

                    </div>


                    <!-- MOOD -->
                    <div class="col-md-6">

                        <label class="form-label">
                            Mood
                        </label>

                        <select class="form-select"
                                id="mood">

                            <option value="">Select mood</option>
                            <option value="😊 Good">😊 Good</option>
                            <option value="🙂 Okay">🙂 Okay</option>
                            <option value="😐 Neutral">😐 Neutral</option>
                            <option value="😟 Stressed">😟 Stressed</option>
                            <option value="😴 Tired">😴 Tired</option>

                        </select>

                    </div>


                    <!-- SYMPTOMS -->
                    <div class="col-md-12">

                        <label class="form-label">
                            Symptoms / Health Notes
                        </label>

                        <textarea class="form-control"
                                  id="symptoms"
                                  rows="3"
                                  placeholder="Enter any symptoms or notes..."></textarea>

                    </div>


                    <!-- BUTTON -->
                    <div class="col-md-12">

                        <button type="submit"
                                class="btn btn-primary">

                            Save Health Entry

                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="clearForm()">

                            Clear

                        </button>

                    </div>

                </div>

            </form>

        </div>


        <!-- HEALTH HISTORY -->
        <div class="health-card">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="section-title mb-0">
                    Health History
                </h5>

                <div class="d-flex align-items-end gap-2 flex-wrap">
                    <div>
                        <label for="historyFrom" class="form-label small mb-1">From</label>
                        <input type="date" id="historyFrom" class="form-control form-control-sm">
                    </div>
                    <div>
                        <label for="historyTo" class="form-label small mb-1">To</label>
                        <input type="date" id="historyTo" class="form-control form-control-sm">
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearHistoryFilter()">Clear dates</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearAllHealthData()">Clear All</button>
                </div>

            </div>


            <div class="table-card">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>
                            <th>Date</th>
                            <th>Weight</th>
                            <th>Blood Pressure</th>
                            <th>Heart Rate</th>
                            <th>Mood</th>
                            <th>Notes</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody id="healthTableBody">
                    </tbody>

                </table>

            </div>

        </div>


        <!-- INFORMATION -->
        <div class="health-summary">

            <h5>
                Health Tracking
            </h5>

            <p class="mb-0 text-muted">

                This page is currently a demonstration version.
                Health information entered here is stored only in your
                browser using localStorage and is not saved to the
                NMB-HLabSys database.

            </p>

        </div>

    </div>


    <script>

        /*
         * ==========================================================
         * HEALTH TRACKING - LOCAL STORAGE VERSION
         * ==========================================================
         */

        const STORAGE_KEY = "nmb_hlabsys_health_tracking";


        // ----------------------------------------------------------
        // GET DATA
        // ----------------------------------------------------------

        function getHealthData() {

            const data = localStorage.getItem(STORAGE_KEY);

            if (!data) {
                return [];
            }

            try {

                return JSON.parse(data);

            } catch (error) {

                console.error("Could not read health data:", error);

                return [];

            }
        }


        // ----------------------------------------------------------
        // SAVE DATA
        // ----------------------------------------------------------

        function saveHealthData(data) {

            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(data)
            );

        }


        // ----------------------------------------------------------
        // FORM SUBMIT
        // ----------------------------------------------------------

        document
            .getElementById("healthForm")
            .addEventListener("submit", function (event) {

                event.preventDefault();


                const entry = {

                    id: Date.now(),

                    date:
                        document
                            .getElementById("healthDate")
                            .value,

                    weight:
                        document
                            .getElementById("weight")
                            .value,

                    bloodPressure:
                        document
                            .getElementById("bloodPressure")
                            .value,

                    heartRate:
                        document
                            .getElementById("heartRate")
                            .value,

                    mood:
                        document
                            .getElementById("mood")
                            .value,

                    symptoms:
                        document
                            .getElementById("symptoms")
                            .value

                };


                let healthData = getHealthData();


                healthData.push(entry);


                saveHealthData(healthData);


                renderHealthHistory();


                updateSummary();


                clearForm();


                alert("Health information saved successfully.");

            });


        // ----------------------------------------------------------
        // DISPLAY HISTORY
        // ----------------------------------------------------------

        function renderHealthHistory() {

            const tableBody =
                document.getElementById("healthTableBody");


            const from = document.getElementById("historyFrom").value;
            const to = document.getElementById("historyTo").value;
            const healthData = getHealthData().filter(function (entry) {
                return (!from || entry.date >= from) && (!to || entry.date <= to);
            });


            tableBody.innerHTML = "";


            if (healthData.length === 0) {

                tableBody.innerHTML = `

                    <tr>

                        <td colspan="7">

                            <div class="empty-state">

                                No health information recorded for the selected date range.

                            </div>

                        </td>

                    </tr>

                `;

                return;

            }

            // Newest first

            healthData.sort(function (a, b) {

                return new Date(b.date) - new Date(a.date);

            });


            healthData.forEach(function (entry) {

                const row =
                    document.createElement("tr");


                row.innerHTML = `

                    <td>
                        ${formatDate(entry.date)}
                    </td>

                    <td>
                        ${entry.weight
                            ? entry.weight + " kg"
                            : "--"}
                    </td>

                    <td>
                        ${entry.bloodPressure || "--"}
                    </td>

                    <td>
                        ${entry.heartRate
                            ? entry.heartRate + " bpm"
                            : "--"}
                    </td>

                    <td>
                        ${entry.mood || "--"}
                    </td>

                    <td>
                        ${entry.symptoms || "--"}
                    </td>

                    <td>

                        <button
                            class="delete-btn"
                            onclick="deleteHealthEntry(${entry.id})">

                            Delete

                        </button>

                    </td>

                `;


                tableBody.appendChild(row);

            });

        }

        function clearHistoryFilter() {
            document.getElementById("historyFrom").value = "";
            document.getElementById("historyTo").value = "";
            renderHealthHistory();
        }

        document.getElementById("historyFrom").addEventListener("change", renderHealthHistory);
        document.getElementById("historyTo").addEventListener("change", renderHealthHistory);


        // ----------------------------------------------------------
        // UPDATE SUMMARY
        // ----------------------------------------------------------

        function updateSummary() {

            const healthData = getHealthData();


            if (healthData.length === 0) {

                document.getElementById("latestWeight")
                    .textContent = "--";

                document.getElementById("latestBloodPressure")
                    .textContent = "--";

                document.getElementById("latestHeartRate")
                    .textContent = "--";

                document.getElementById("latestMood")
                    .textContent = "--";

                return;

            }


            healthData.sort(function (a, b) {

                return new Date(b.date) - new Date(a.date);

            });


            const latest = healthData[0];


            document.getElementById("latestWeight")
                .textContent =
                latest.weight || "--";


            document.getElementById("latestBloodPressure")
                .textContent =
                latest.bloodPressure || "--";


            document.getElementById("latestHeartRate")
                .textContent =
                latest.heartRate || "--";


            document.getElementById("latestMood")
                .textContent =
                latest.mood || "--";

        }


        // ----------------------------------------------------------
        // DELETE ENTRY
        // ----------------------------------------------------------

        function deleteHealthEntry(id) {

            if (!confirm("Delete this health entry?")) {
                return;
            }


            let healthData = getHealthData();


            healthData =
                healthData.filter(function (entry) {

                    return entry.id !== id;

                });


            saveHealthData(healthData);


            renderHealthHistory();


            updateSummary();

        }


        // ----------------------------------------------------------
        // CLEAR ALL
        // ----------------------------------------------------------

        function clearAllHealthData() {

            if (!confirm(
                "Are you sure you want to delete all health tracking data?"
            )) {

                return;

            }


            localStorage.removeItem(STORAGE_KEY);


            renderHealthHistory();


            updateSummary();

        }


        // ----------------------------------------------------------
        // CLEAR FORM
        // ----------------------------------------------------------

        function clearForm() {

            document
                .getElementById("healthForm")
                .reset();


            setToday();

        }


        // ----------------------------------------------------------
        // FORMAT DATE
        // ----------------------------------------------------------

        function formatDate(dateString) {

            if (!dateString) {
                return "--";
            }


            const date = new Date(dateString);


            return date.toLocaleDateString(
                "en-ZA",
                {
                    year: "numeric",
                    month: "short",
                    day: "numeric"
                }
            );

        }


        // ----------------------------------------------------------
        // SET TODAY
        // ----------------------------------------------------------

        function setToday() {

            const today =
                new Date()
                    .toISOString()
                    .split("T")[0];


            document
                .getElementById("healthDate")
                .value = today;

        }


        // ----------------------------------------------------------
        // INITIALIZE
        // ----------------------------------------------------------

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                setToday();

                renderHealthHistory();

                updateSummary();

            }
        );

    </script>

</body>
</html>