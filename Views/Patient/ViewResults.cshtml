@* ── Views/Patient/ViewResults.cshtml ── *@
@model NMB_HLabSys.Models.Domain.TestRequest
@{
    ViewData["Title"] = "My Results";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-clipboard2-check text-success me-2"></i>
            Results – @Model.RequestNumber
        </h4>
        <p class="text-muted mb-0">Date: @Model.RequestDate.ToString("dd MMM yyyy")</p>
        <p class="text-muted mb-0">Doctor: @(Model.Doctor == null ? "—" : $"Dr {Model.Doctor.Name} {Model.Doctor.Surname}")</p>
    </div>
    <span class="badge bg-success fs-6">Released</span>
</div>

@{
    // bool hasAbnormal = Model.TestTypes.Any(t => t.IsAbnormal);
    bool hasAbnormal = Model.RequestTestTypes.Any(t => t.IsAbnormal);
}
@if (hasAbnormal)
{
    <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Some results are <strong>outside the normal range</strong> – please discuss with your doctor.
    </div>
}

<div class="card mb-4">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Test</th>
                    <th class="text-center">Result</th>
                    <th class="text-center">Units</th>
                    <th class="text-center">Normal Range</th>
                    <th class="text-center">Flag</th>
                    <th>Technician notes</th>
                    <th>Completed</th>
                </tr>
            </thead>
            <tbody>
                @* @foreach (var t in Model.TestTypes) *@
                @foreach (var t in Model.RequestTestTypes)
                {
                    <tr class="@(t.IsAbnormal ? "alert-abnormal" : "")">
                        <td class="fw-semibold">@t.TestType?.TestName</td>
                        <td class="text-center fw-bold @(t.IsAbnormal ? "text-danger" : "text-success")">
                            @(t.ResultValue?.ToString("F2") ?? "—")
                        </td>
                        <td class="text-center text-muted small">@(t.TestType?.Units ?? "—")</td>
                        <td class="text-center text-muted small">
                            @if (t.TestType?.NormalRangeMin.HasValue == true && t.TestType?.NormalRangeMax.HasValue == true)
                            {
                                @($"{t.TestType.NormalRangeMin:F2} – {t.TestType.NormalRangeMax:F2}")
                            }
                            else
                            {

                                <span>—</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (t.IsAbnormal)
                            {
                                <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Abnormal</span>
                            }
                            else
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Normal</span>
                            }
                        </td>
                        <td class="small">
                            @if (string.IsNullOrWhiteSpace(t.ResultNotes))
                            {
                                <span class="text-muted">No technician notes</span>
                            }
                            else
                            {
                                <span>@t.ResultNotes</span>
                                @if (t.Technician != null)
                                {
                                    <span class="text-muted d-block">
                                        @t.Technician.Name @t.Technician.Surname
                                    </span>
                                }
                            }
                        </td>
                        <td class="small text-muted">
                            @(t.CompletedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
    <a asp-controller="Report" asp-action="PatientRequestPdf" asp-route-requestId="@Model.RequestId"
       class="btn btn-danger">
        <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
    </a>
</div>
