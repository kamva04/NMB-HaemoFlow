@model IEnumerable<NMB_HLabSys.Models.ViewModels.DoctorAlertViewModel>

@{
    ViewData["Title"] = "Abnormal Result Alerts";
    var since = ViewBag.Since as DateTime? ?? DateTime.Today.AddDays(-5);
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">
                <i class="bi bi-bell-fill text-danger"></i>
                Abnormal Result Alerts
            </h2>
            <p class="text-muted mb-0">
                Abnormal test results for tests ordered by you.
            </p>
        </div>

        <a asp-controller="Doctor"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>

    <!-- Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Doctor"
                  asp-action="Alerts"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="from" class="form-label fw-semibold">
                        Show alerts from
                    </label>

                    <input type="date"
                           id="from"
                           name="from"
                           class="form-control"
                           value="@since.ToString("yyyy-MM-dd")" />

                    <small class="text-muted">
                        Default: last 5 days
                    </small>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-funnel-fill"></i>
                        Filter Alerts
                    </button>
                </div>

                <div class="col-md-3">
                    <a asp-controller="Doctor"
                       asp-action="Alerts"
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Last 5 Days
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Alert count -->
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>@Model.Count()</strong>
        abnormal result(s) found from
        <strong>@since.ToString("dd MMM yyyy")</strong>.
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle-fill text-success"
                   style="font-size: 3rem;"></i>

                <h4 class="mt-3">No abnormal results found</h4>

                <p class="text-muted">
                    There are no abnormal test results for your patients
                    from the selected date.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Abnormal Results
                </h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Request No.</th>
                            <th>Patient</th>
                            <th>Test</th>
                            <th>Result</th>
                            <th>Normal Range</th>
                            <th>Date Completed</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                    
                        @foreach (var alert in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">
                                        @alert.RequestNumber
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @alert.PatientName
                                </td>

                                <td>
                                    @alert.TestName
                                </td>

                                <td>
                                    <span class="badge bg-danger">
                                        @alert.ResultValue @alert.Units
                                    </span>
                                </td>

                                <td>
                                    @alert.NormalRangeMin -
                                    @alert.NormalRangeMax
                                    @alert.Units
                                </td>

                                <td>
                                    @if (alert.CompletedAt.HasValue)
                                    {
                                        @alert.CompletedAt.Value.ToString("dd MMM yyyy HH:mm")
                                    }
                                </td>

                                <td>
                                    <a asp-controller="Doctor"
                                       asp-action="RequestDetails"
                                       asp-route-id="@alert.RequestId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                        View Result
                                    </a>
                                </td>
                            </tr>
                        }
                     
                    </tbody>

                </table>
            </div>
        </div>
    }
 

</div>
