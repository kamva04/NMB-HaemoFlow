@* ── Views/Doctor/RequestDetails.cshtml ── *@
@model NMB_HLabSys.Models.ViewModels.TestRequestDetailsViewModel
@{
    ViewData["Title"] = "Request Details";
    var req = Model.Request;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">@TempData["Warning"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-clipboard2-pulse text-primary me-2"></i>
            @req.RequestNumber
        </h4>
        <p class="text-muted mb-0">
            Patient: <strong>@req.Patient?.Name @req.Patient?.Surname</strong> &nbsp;|&nbsp;
            Date: @req.RequestDate.ToString("dd MMM yyyy HH:mm") &nbsp;|&nbsp;
            Urgency:
            <span class="badge @(req.Urgency=="Stat"?"badge-stat":req.Urgency=="Urgent"?"badge-urgent":"badge-routine")">
                @req.Urgency
            </span>
        </p>
    </div>
    <span class="badge fs-6
        @(req.Status=="Completed"||req.Status=="ReleasedByDoctor"?"bg-success":
          req.Status=="Cancelled"?"bg-danger":
          req.Status=="InProgress"?"bg-primary":"bg-secondary")">
        @NMB_HLabSys.Helpers.StatusDisplay.Format(req.Status)
    </span>
</div>

@if (req.ClinicalNotes != null)
{
    <div class="alert alert-light border mb-4">
        <strong><i class="bi bi-journal-text me-1"></i>Clinical Notes:</strong> @req.ClinicalNotes
    </div>
}

@if (req.RequestSamples.Any())
{
    <div class="card mb-4">
        <div class="card-header fw-semibold">Generated Samples (read-only)</div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0 align-middle">
                <thead class="table-light"><tr><th>Test type</th><th>Barcode</th><th>Sample type</th></tr></thead>
                <tbody>
                    @foreach (var sample in req.RequestSamples)
                    {
                        <tr>
                            <td>@sample.RequestTest?.TestType?.TestName</td>
                            <td class="font-monospace">@sample.Barcode</td>
                            <td>@sample.SampleType?.TypeName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.HasAbnormal)
{
    <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Abnormal results detected</strong> – highlighted below.
    </div>
}

@if (req.Status == "Cancelled")
{
    <div class="alert alert-danger mb-4">
        <strong><i class="bi bi-x-circle me-1"></i>Cancellation reason:</strong>
        @(Model.CancellationReason ?? "No reason recorded.")
    </div>
}

@if (Model.ReleasedAt.HasValue)
{
    <div class="alert alert-success mb-4">
        <strong><i class="bi bi-check-circle me-1"></i>Released to patient:</strong>
        @Model.ReleasedAt.Value.ToString("dd MMM yyyy HH:mm")
        @if (!string.IsNullOrWhiteSpace(Model.ReleaseNotifyType))
        {
            <span> via @Model.ReleaseNotifyType.</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ReleaseDoctorNote))
        {
            <br /><strong>Doctor note:</strong> @Model.ReleaseDoctorNote
        }
    </div>
}

<div class="card mb-4">
    <div class="card-header fw-semibold">Test Results</div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Test</th>
                    <th class="text-center">Result</th>
                    <th class="text-center">Units</th>
                    <th class="text-center">Normal Range</th>
                    <th class="text-center">Status</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.TestResults)
                {
                    <tr class="@(t.IsAbnormal ? "alert-abnormal" : "")">
                        <td class="fw-semibold">
                            @t.TestType?.TestName
                            @if (t.IsAbnormal)
                            {
                                <i class="bi bi-exclamation-circle text-warning ms-1" title="Abnormal"></i>
                            }
                        </td>
                        <td class="text-center fw-bold @(t.IsAbnormal ? "text-danger" : "")">
                            @(t.ResultValue?.ToString("F2") ?? "—")
                        </td>
                        <td class="text-center text-muted small">@(t.TestType?.Units ?? "—")</td>
                        <td class="text-center text-muted small">
                            @if (t.TestType?.NormalRangeMin.HasValue == true && t.TestType?.NormalRangeMax.HasValue == true)
                            {
                                @($"{t.TestType.NormalRangeMin:F2} – {t.TestType.NormalRangeMax:F2}")
                            }
                            else { <span>—</span> }
                        </td>
                        <td class="text-center">
                            <span class="badge
                                @(t.Status=="Verified"?"bg-success":
                                  t.Status=="Completed"?"bg-info text-dark":
                                  t.Status=="InProgress"?"bg-primary":
                                  t.Status=="ToBeReviewed"?"bg-warning text-dark":"bg-secondary")">
                                @t.Status
                            </span>
                        </td>
                        <td class="small text-muted">@(t.ResultNotes ?? "—")</td>
                    </tr>
                }
                @if (!Model.TestResults.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No results yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2 flex-wrap">
    @if (req.Status == "Completed")
    {
        <a asp-action="ReleaseResults" asp-route-requestId="@req.RequestId"
           class="btn btn-success">
            <i class="bi bi-send me-1"></i>Release Results to Patient
        </a>
    }
    @if (req.Status is "Completed" or "ReleasedByDoctor")
    {
        <a asp-action="ProposeAppointment" asp-route-patientId="@req.PatientId" asp-route-requestId="@req.RequestId"
           class="btn btn-outline-primary">
            <i class="bi bi-calendar2-plus me-1"></i>Arrange Appointment
        </a>
    }
    @if (req.Status is "Completed" or "ReleasedByDoctor")
    {
        <a asp-controller="Report" asp-action="RequestResultPdf" asp-route-requestId="@req.RequestId"
           class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i>View Results PDF
        </a>
    }
    @if (req.Status is "Submitted" or "SamplesReceived")
    {
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
            <i class="bi bi-x-circle me-1"></i>Cancel Request
        </button>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Cancel Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CancelRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="requestId" value="@req.RequestId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for Cancellation <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>
