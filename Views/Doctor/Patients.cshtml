@* ── Views/Doctor/Patients.cshtml ── *@
@model IEnumerable<NMB_HLabSys.Models.Domain.Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-people text-primary me-2"></i>My Patients</h4>
    <a asp-action="CreatePatient" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Register New Patient
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Patient</th>
                    <th>ID Number</th>
                    <th>Email</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.Name @p.Surname</td>
                        <td class="font-monospace small">@p.SAIDNumber</td>
                        <td class="text-muted small">@p.User?.Email</td>
                        <td class="text-end">
                            <a asp-action="PatientDetails" asp-route-id="@p.PatientId"
                               class="btn btn-sm btn-outline-secondary me-1">
                                <i class="bi bi-person-lines-fill me-1"></i>View
                            </a>
                            <a asp-action="CreateRequest" asp-route-patientId="@p.PatientId"
                               class="btn btn-sm btn-primary">
                                <i class="bi bi-clipboard2-plus me-1"></i>New Request
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No patients on record.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
