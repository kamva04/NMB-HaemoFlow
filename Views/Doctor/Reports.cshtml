@model NMB_HLabSys.Models.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Doctor Reports";
}

<div class="mb-4">
    <h4 class="fw-bold mb-0">
        <i class="bi bi-file-earmark-bar-graph text-primary me-2"></i>Doctor Reports
    </h4>
    <p class="text-muted">Generate PDF reports and view live summaries of your activity</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="row g-4">

    <!-- ── CARD 1: All Test Requests PDF ─────────────────────────── -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-clipboard2-pulse text-primary"></i>
                My Test Requests
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    A summary of all test requests you submitted within a chosen date range,
                    including patient name, urgency and current status.
                </p>

                <form asp-controller="Report" asp-action="DoctorRequestsReport"
                      method="post" id="reqReportForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="FromDate" class="form-label fw-semibold small"></label>
                            <input asp-for="FromDate" type="date" class="form-control form-control-sm"
                                   id="reqFrom" />
                            <span asp-validation-for="FromDate" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="ToDate" class="form-label fw-semibold small"></label>
                            <input asp-for="ToDate" type="date" class="form-control form-control-sm"
                                   id="reqTo" />
                            <span asp-validation-for="ToDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="previewReqBtn">
                            <i class="bi bi-eye me-1"></i>Preview
                        </button>
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                        </button>
                    </div>
                </form>

                <!-- Inline preview -->
                <div id="reqPreview" style="display:none;">
                    <div class="table-responsive" style="max-height:280px; overflow-y:auto;">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th>Request #</th>
                                    <th>Patient</th>
                                    <th>Date</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th class="text-center">Tests</th>
                                </tr>
                            </thead>
                            <tbody id="reqPreviewBody">
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-2 small text-muted" id="reqPreviewSummary"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── CARD 2: Abnormal Alerts ───────────────────────────────── -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                Abnormal Result Alerts
                <span class="badge bg-danger ms-auto" id="abnBadge" style="display:none;"></span>
            </div>
            <div class="card-body p-0">
                <div class="px-3 pt-3 pb-2 d-flex gap-2 align-items-center">
                    <label class="form-label fw-semibold small mb-0">Show from:</label>
                    <input type="date" id="alertFrom" class="form-control form-control-sm"
                           style="width:160px"
                           value="@DateTime.Today.AddDays(-5).ToString("yyyy-MM-dd")" />
                    <button class="btn btn-sm btn-outline-danger" id="loadAlertsBtn">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-action="Alerts" class="btn btn-sm btn-danger ms-auto">
                        <i class="bi bi-bell me-1"></i>Full Alerts Page
                    </a>
                </div>
                <div class="table-responsive" style="max-height:320px;overflow-y:auto;">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Request #</th>
                                <th>Patient</th>
                                <th>Test</th>
                                <th class="text-center">Result</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody id="alertsBody">
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3 small">
                                    <span class="spinner-border spinner-border-sm me-2"></span>Loading…
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ── CARD 3: Request Status Summary ────────────────────────── -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-pie-chart-fill text-info"></i>
                Request Status Breakdown
            </div>
            <div class="card-body">
                <canvas id="statusChart" style="max-height:220px;"></canvas>
                <div id="statusTableWrap" class="mt-3" style="display:none;">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Status</th><th class="text-center">Count</th></tr>
                        </thead>
                        <tbody id="statusTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ── CARD 4: Patient Result PDF ────────────────────────────── -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-success"></i>
                Patient Result Report
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Generate a PDF of all verified results for a specific patient
                    over a date range.
                </p>
                <form asp-controller="Report" asp-action="DoctorPatientReport" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Patient</label>
                        <select name="patientId" class="form-select form-select-sm"
                                id="patientSelect">
                            <option value="">— Select Patient —</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">From</label>
                            <input name="fromDate" type="date" class="form-control form-control-sm"
                                   value="@DateTime.Today.AddMonths(-3).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">To</label>
                            <input name="toDate" type="date" class="form-control form-control-sm"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        const requestsPreviewUrl = '@Url.Action("RequestsPreviewJson", "Doctor")';
        const alertsUrl = '@Url.Action("AlertsJson", "Doctor")';
        const statusSummaryUrl = '@Url.Action("StatusSummaryJson", "Doctor")';
        const patientsUrl = '@Url.Action("MyPatientsJson", "Doctor")';

        // ── 1. Preview test requests ──────────────────────────────────
        document.getElementById('previewReqBtn').addEventListener('click', async function() {
            const from = document.getElementById('reqFrom').value;
            const to = document.getElementById('reqTo').value;
            if (!from || !to) { alert('Please select both dates.'); return; }

            this.disabled = true;
            this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Loading…';

            try {
                const params = new URLSearchParams({ from, to });
                const res = await fetch(`${requestsPreviewUrl}?${params}`);
                if (!res.ok) throw new Error(`Could not load preview (HTTP ${res.status}).`);
                const data = await res.json();
                const tbody = document.getElementById('reqPreviewBody');

                const urgencyBadge = u => u === 'Stat'
                    ? '<span class="badge badge-stat">Stat</span>'
                    : u === 'Urgent'
                        ? '<span class="badge badge-urgent">Urgent</span>'
                        : '<span class="badge badge-routine">Routine</span>';

                const statusBadge = s => {
                    const m = {
                        Completed: 'bg-success', ReleasedByDoctor: 'bg-success',
                        Cancelled: 'bg-danger', InProgress: 'bg-primary',
                        SamplesReceived: 'bg-info text-dark'
                    };
                    return `<span class="badge ${m[s] ?? 'bg-secondary'}">${s}</span>`;
                };

                if (!data.length) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-2">No requests in this period.</td></tr>';
                } else {
                    tbody.innerHTML = data.map(r =>
                        `<tr>
                                    <td class="font-monospace small">${r.requestNumber}</td>
                                    <td class="small">${r.patient}</td>
                                    <td class="small">${new Date(r.requestDate).toLocaleDateString('en-ZA', { day: '2-digit', month: 'short', year: 'numeric' })}</td>
                                    <td>${urgencyBadge(r.urgency)}</td>
                                    <td>${statusBadge(r.status)}</td>
                                    <td class="text-center">${r.testCount}</td>
                                </tr>`
                    ).join('');

                    document.getElementById('reqPreviewSummary').textContent =
                        `${data.length} request(s) found • Click "Download PDF" to save.`;
                }

                document.getElementById('reqPreview').style.display = 'block';
            } catch (e) {
                document.getElementById('reqPreviewBody').innerHTML =
                    '<tr><td colspan="6" class="text-center text-danger py-2 small">Failed to load preview.</td></tr>';
            } finally {
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-eye me-1"></i>Preview';
            }
        });

        // ── 2. Load abnormal alerts ───────────────────────────────────
        async function loadAlerts() {
            const from = document.getElementById('alertFrom').value;
            const tbody = document.getElementById('alertsBody');
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-2 small"><span class="spinner-border spinner-border-sm me-1"></span>Loading…</td></tr>';

            try {
                const params = new URLSearchParams();
                if (from) params.set('from', from);
                const res = await fetch(`${alertsUrl}?${params}`);
                if (!res.ok) throw new Error(`Could not load alerts (HTTP ${res.status}).`);
                const data = await res.json();
                const badge = document.getElementById('abnBadge');

                if (!data.length) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-success py-3 small"><i class="bi bi-check-circle me-1"></i>No abnormal results in this period.</td></tr>';
                    badge.style.display = 'none';
                    return;
                }

                badge.textContent = data.length;
                badge.style.display = '';

                tbody.innerHTML = data.map(a =>
                    `<tr class="alert-abnormal">
                                <td class="font-monospace small fw-semibold">${a.requestNumber}</td>
                                <td class="small">${a.patientName}</td>
                                <td class="small"><i class="bi bi-exclamation-circle text-danger me-1"></i>${a.testName}</td>
                                <td class="text-center fw-bold text-danger small">
                                    ${a.resultValue !== null ? Number(a.resultValue).toFixed(2) : '—'}
                                    <span class="text-muted">${a.units ?? ''}</span>
                                </td>
                                <td class="small text-muted">${new Date(a.completedAt).toLocaleDateString('en-ZA', { day: '2-digit', month: 'short', year: 'numeric' })}</td>
                            </tr>`
                ).join('');
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-2 small">Failed to load alerts.</td></tr>';
            }
        }
        loadAlerts();
        document.getElementById('loadAlertsBtn').addEventListener('click', loadAlerts);

        // ── 3. Status breakdown chart ─────────────────────────────────
        (async function() {
            try {
                const res = await fetch(statusSummaryUrl);
                if (!res.ok) throw new Error(`Could not load request status (HTTP ${res.status}).`);
                const data = await res.json();
                if (!data.length) return;

                const labels = data.map(d => d.status);
                const counts = data.map(d => d.count);
                const colors = {
                    'Submitted': '#6c757d',
                    'SamplesReceived': '#0dcaf0',
                    'InProgress': '#0d6efd',
                    'Completed': '#198754',
                    'ReleasedByDoctor': '#20c997',
                    'Cancelled': '#dc3545'
                };
                const bgColors = labels.map(l => colors[l] ?? '#adb5bd');

                new Chart(document.getElementById('statusChart'), {
                    type: 'doughnut',
                    data: { labels, datasets: [{ data: counts, backgroundColor: bgColors, borderWidth: 1 }] },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { position: 'bottom', labels: { font: { size: 11 } } },
                            tooltip: {
                                callbacks: {
                                    label: ctx => ` ${ctx.label}: ${ctx.parsed}`
                                }
                            }
                        }
                    }
                });

                // Also populate the table below the chart
                const tbody = document.getElementById('statusTableBody');
                tbody.innerHTML = data.map(d =>
                    `<tr><td>${d.status}</td><td class="text-center fw-semibold">${d.count}</td></tr>`
                ).join('');
                document.getElementById('statusTableWrap').style.display = 'block';
            } catch (e) {
                document.getElementById('statusTableWrap').insertAdjacentHTML('beforebegin',
                    '<div class="small text-danger">Could not load request status summary.</div>');
            }
        })();

        // ── 4. Load patients into select ──────────────────────────────
        (async function() {
            try {
                const res = await fetch(patientsUrl);
                if (!res.ok) throw new Error(`Could not load patients (HTTP ${res.status}).`);
                const data = await res.json();
                const sel = document.getElementById('patientSelect');
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.patientId;
                    opt.textContent = `${p.name} ${p.surname} (DOB: ${p.dateOfBirth ? new Date(p.dateOfBirth).toLocaleDateString('en-ZA') : '—'})`;
                    sel.appendChild(opt);
                });
            } catch (e) {
                const sel = document.getElementById('patientSelect');
                const opt = document.createElement('option');
                opt.disabled = true;
                opt.textContent = 'Could not load patients';
                sel.appendChild(opt);
            }
        })();
    </script>
}