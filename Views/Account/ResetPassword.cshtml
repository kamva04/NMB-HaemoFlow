@* ── Views/Account/ResetPassword.cshtml ── *@
@model NMB_HLabSys.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background:linear-gradient(135deg,#0d3b66 0%,#1a8fe3 100%);">
    <div class="card shadow-lg" style="width:100%;max-width:430px;">
        <div class="card-body p-5">
            <div class="text-center mb-4"><partial name="_AuthLogo" /></div>
            <h5 class="fw-bold mb-1"><i class="bi bi-key-fill text-primary me-2"></i>Reset Password</h5>
            <p class="text-muted small mb-4">Choose a strong new password.</p>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />

                <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="NewPassword" class="form-control" id="np" />
                        <button type="button" class="btn btn-outline-secondary toggle-pw" data-target="np">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <div class="form-text">Min 8 chars · 1 uppercase · 1 number · 1 special character</div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" class="form-control" id="cp" />
                        <button type="button" class="btn btn-outline-secondary toggle-pw" data-target="cp">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-2"></i>Reset Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.toggle-pw').forEach(btn => {
        btn.addEventListener('click', function () {
            const f = document.getElementById(this.dataset.target);
            const icon = this.querySelector('i');
            if (f.type === 'password') { f.type = 'text';     icon.className = 'bi bi-eye-slash'; }
            else                       { f.type = 'password'; icon.className = 'bi bi-eye'; }
        });
    });
</script>
<partial name="_ValidationScriptsPartial" />
}
