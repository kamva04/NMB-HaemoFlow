@* ── Views/Account/ChangePassword.cshtml ── *@
@model NMB_HLabSys.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    bool firstLogin = ViewBag.FirstLogin == true;
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-key me-2"></i>
                    @(firstLogin ? "Set Your Password (First Login)" : "Change Password")
                </h5>
            </div>
            <div class="card-body p-4">
                @if (firstLogin)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        You must change your temporary password before continuing.
                    </div>
                }

                <form asp-action="ChangePassword" asp-route-firstLogin="@firstLogin" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" class="form-control" id="curPw" />
                            <button type="button" class="btn btn-outline-secondary toggle-pw" data-target="curPw">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" class="form-control" id="newPw" />
                            <button type="button" class="btn btn-outline-secondary toggle-pw" data-target="newPw">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text">Min 8 chars · 1 uppercase · 1 number · 1 special character</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" id="confPw" />
                            <button type="button" class="btn btn-outline-secondary toggle-pw" data-target="confPw">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-2"></i>Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.toggle-pw').forEach(btn => {
        btn.addEventListener('click', function () {
            const f = document.getElementById(this.dataset.target);
            const icon = this.querySelector('i');
            if (f.type === 'password') { f.type = 'text';     icon.className = 'bi bi-eye-slash'; }
            else                       { f.type = 'password'; icon.className = 'bi bi-eye'; }
        });
    });
</script>
<partial name="_ValidationScriptsPartial" />
}
