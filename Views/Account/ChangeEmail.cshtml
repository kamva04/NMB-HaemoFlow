@* ── Views/Account/ChangeEmail.cshtml ── *@
@model NMB_HLabSys.Models.ViewModels.ChangeEmailViewModel
@{
    ViewData["Title"] = "Change Email";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-envelope me-2"></i>Change Email / Username</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-info small mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Your email address is also your login username. You will need to use the new address next time you log in.
                </div>

                <form asp-action="ChangeEmail" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>

                    <div class="mb-3">
                        <label asp-for="NewEmail" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="NewEmail" class="form-control" type="email"
                                   placeholder="new@example.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="NewEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmEmail" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope-check"></i></span>
                            <input asp-for="ConfirmEmail" class="form-control" type="email"
                                   placeholder="Confirm new email" autocomplete="email" />
                        </div>
                        <span asp-validation-for="ConfirmEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" class="form-control" id="curPw" />
                            <button type="button" class="btn btn-outline-secondary toggle-pw"
                                    data-target="curPw">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Update Email
                        </button>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.toggle-pw').forEach(btn => {
        btn.addEventListener('click', function () {
            const f    = document.getElementById(this.dataset.target);
            const icon = this.querySelector('i');
            f.type     = f.type === 'password' ? 'text' : 'password';
            icon.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        });
    });
</script>
<partial name="_ValidationScriptsPartial" />
}
