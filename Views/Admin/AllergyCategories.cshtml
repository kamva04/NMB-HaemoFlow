@* ── Views/Admin/AllergyCategories.cshtml ── *@
@model IEnumerable<NMB_HLabSys.Models.Domain.AllergyCategory>
@{
    ViewData["Title"] = "Allergy Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-folder2 text-warning me-2"></i>Allergy Categories</h4>
    <a asp-action="CreateAllergyCategory" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Category</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark"><tr><th>Category Name</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.CategoryName</td>
                        <td><span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Archived")</span></td>
                        <td class="text-end">
                            <a asp-action="EditAllergyCategory" asp-route-id="@c.CategoryId"
                               class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                            <form asp-action="@(c.IsActive ? "DeleteAllergyCategory" : "RestoreAllergyCategory")" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.CategoryId" />
                                <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                    <i class="bi @(c.IsActive ? "bi-archive" : "bi-arrow-counterclockwise")"></i>
                                    @(c.IsActive ? "Archive" : "Restore")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-4">No categories yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
