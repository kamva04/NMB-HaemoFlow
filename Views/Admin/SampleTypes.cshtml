@* ── Views/Admin/SampleTypes.cshtml ── *@
@model IEnumerable<NMB_HLabSys.Models.Domain.SampleType>
@{
    ViewData["Title"] = "Sample Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-droplet-half text-primary me-2"></i>Sample Types</h4>
    <a asp-action="CreateSampleType" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Sample Type</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr><th>Sample Type</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.TypeName @if (s.IsDeleted) { <span class="badge bg-secondary ms-2">Archived</span> }</td>
                        <td class="text-end">
                            <form asp-action="@(s.IsDeleted ? "RestoreSampleType" : "DeleteSampleType")" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.SampleTypeId" />
                                <button type="submit" class="btn btn-sm @(s.IsDeleted ? "btn-outline-success" : "btn-outline-danger")"
                                        onclick="return confirm(this.dataset.confirm)"
                                        data-confirm="@(s.IsDeleted ? "Restore this record?" : "Archive this record? Its history will be preserved.")">
                                    @(s.IsDeleted ? "Restore" : "Archive")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="2" class="text-center text-muted py-4">No sample types yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
