@model NMB_HLabSys.Models.ViewModels.NotificationListViewModel
@{
    ViewData["Title"] = "Notifications";

    string CategoryBadge(string cat) => cat switch
    {
        "Overdue" => "bg-danger",
        "NearDue" => "bg-warning text-dark",
        "Stock" => "bg-info text-dark",
        "STAT" => "bg-danger",
        _ => "bg-secondary"
    };

    string CategoryIcon(string cat) => cat switch
    {
        "Overdue" => "bi-exclamation-octagon-fill",
        "NearDue" => "bi-alarm-fill",
        "Stock" => "bi-box-seam-fill",
        "STAT" => "bi-lightning-charge-fill",
        _ => "bi-info-circle-fill"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-bell-fill text-primary me-2"></i>Notifications</h3>
        <div class="text-muted">
            @Model.TotalCount total · <strong>@Model.UnreadCount</strong> unread
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.UnreadCount > 0)
        {
            <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnFilter" value="@Model.Filter" />
                <button class="btn btn-outline-primary">
                    <i class="bi bi-check2-all me-1"></i>Mark all as read
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* FILTERS *@
<div class="btn-group mb-3 flex-wrap" role="group">
    <a asp-action="Index" class="btn @(string.IsNullOrEmpty(Model.Filter) ? "btn-primary" : "btn-outline-primary")">
        All
    </a>
    <a asp-action="Index" asp-route-filter="Unread" class="btn @(Model.Filter == "Unread" ? "btn-primary" : "btn-outline-primary")">
        Unread
    </a>
    <a asp-action="Index" asp-route-filter="Overdue" class="btn @(Model.Filter == "Overdue" ? "btn-primary" : "btn-outline-primary")">
        Overdue
    </a>
    <a asp-action="Index" asp-route-filter="NearDue" class="btn @(Model.Filter == "NearDue" ? "btn-primary" : "btn-outline-primary")">
        Nearing due
    </a>
    <a asp-action="Index" asp-route-filter="Stock" class="btn @(Model.Filter == "Stock" ? "btn-primary" : "btn-outline-primary")">
        Stock
    </a>
    <a asp-action="Index" asp-route-filter="STAT" class="btn @(Model.Filter == "STAT" ? "btn-primary" : "btn-outline-primary")">
        STAT
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Notifications.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-bell-slash display-4 d-block mb-3"></i>
                <div>No notifications to show.</div>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var n in Model.Notifications)
                {
                    <div class="list-group-item @(n.IsRead ? "" : "bg-light")">
                        <div class="d-flex flex-wrap align-items-start gap-3">
                            <div class="fs-4">
                                <span class="badge @CategoryBadge(n.Category) p-2">
                                    <i class="bi @CategoryIcon(n.Category)"></i>
                                </span>
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                    <div>
                                        <div class="fw-semibold">
                                            @n.Title
                                            @if (!n.IsRead)
                                            {
                                                <span class="badge bg-primary ms-1">NEW</span>
                                            }
                                        </div>
                                        <div class="small text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                    </div>
                                </div>
                                <div class="mt-2">@n.Message</div>

                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    @if (!string.IsNullOrWhiteSpace(n.LinkUrl))
                                    {
                                        <form asp-action="MarkAsRead" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@n.NotificationId" />
                                            <input type="hidden" name="returnFilter" value="@Model.Filter" />
                                            <button class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>Open
                                            </button>
                                        </form>
                                    }
                                    else if (!n.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@n.NotificationId" />
                                            <input type="hidden" name="returnFilter" value="@Model.Filter" />
                                            <button class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-check2 me-1"></i>Mark as read
                                            </button>
                                        </form>
                                    }

                                    @if (n.HasCalendar)
                                    {
                                        <a asp-action="CalendarIcs" asp-route-id="@n.NotificationId"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-calendar-plus me-1"></i>Add to calendar
                                        </a>
                                    }

                                    <form asp-action="Dismiss" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.NotificationId" />
                                        <input type="hidden" name="returnFilter" value="@Model.Filter" />
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-lg me-1"></i>Dismiss
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>