<div id="chat-fab" title="Chat with NMB Assistant">
    <i class="bi bi-chat-dots-fill"></i>
</div>

<div id="chat-panel">
    <div class="chat-head">
        <h6><i class="bi bi-robot me-2"></i>NMB Assistant</h6>
        <button type="button" class="btn-close-chat" id="chat-close" aria-label="Close">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div id="chat-messages">
        <div class="msg-row bot">
            <div class="msg-avatar"><i class="bi bi-robot"></i></div>
            <div class="msg-bubble">
                Hello! I'm NMB Assistant. I can help you with:

                • Submitting a test request
                • Lab hours &amp; location
                • Test types offered
                • Result turnaround times
                • Account &amp; password help

                How can I help you today?
            </div>
        </div>
    </div>

    <div class="chat-quick">
        <button type="button" data-q="How do I submit a test request?">📋 Submit request</button>
        <button type="button" data-q="What are your lab hours?">⏰ Lab hours</button>
        <button type="button" data-q="What test types do you offer?">🔬 Test types</button>
        <button type="button" data-q="How do I check my results?">📄 Results</button>
        <button type="button" data-q="I forgot my password">🔒 Account help</button>
    </div>

    <div class="chat-input">
        <input type="text" id="chat-input" placeholder="Ask a question…" maxlength="300" autocomplete="off" />
        <button type="button" id="chat-send"><i class="bi bi-send"></i></button>
    </div>

    <div class="chat-foot">AI-powered • 24/7 Support</div>
</div>

@section Scripts {
    <script>
        (function () {
            var fab      = document.getElementById('chat-fab');
            var panel    = document.getElementById('chat-panel');
            var closeBtn = document.getElementById('chat-close');
            var input    = document.getElementById('chat-input');
            var sendBtn  = document.getElementById('chat-send');
            var messages = document.getElementById('chat-messages');

            function openPanel()  { panel.classList.add('open');  fab.style.display = 'none';  input.focus(); }
            function closePanel() { panel.classList.remove('open'); fab.style.display = 'flex'; }

            fab.addEventListener('click', openPanel);
            closeBtn.addEventListener('click', closePanel);
            sendBtn.addEventListener('click', handleSend);
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); handleSend(); }
            });

            document.querySelectorAll('.chat-quick button').forEach(function (b) {
                b.addEventListener('click', function () {
                    input.value = b.getAttribute('data-q');
                    handleSend();
                });
            });

            function escapeHtml(s) {
                var d = document.createElement('div');
                d.textContent = s;
                return d.innerHTML;
            }

            function appendMessage(text, sender) {
                var row = document.createElement('div');
                row.className = 'msg-row ' + sender;
                var avatar = sender === 'bot'
                    ? '<i class="bi bi-robot"></i>'
                    : '<i class="bi bi-person-fill"></i>';
                row.innerHTML =
                    '<div class="msg-avatar">' + avatar + '</div>' +
                    '<div class="msg-bubble">' + escapeHtml(text) + '</div>';
                messages.appendChild(row);
                messages.scrollTop = messages.scrollHeight;
            }

            function handleSend() {
                var text = input.value.trim();
                if (!text) return;
                appendMessage(text, 'user');
                input.value = '';
                setTimeout(function () {
                    appendMessage(getReply(text), 'bot');
                }, 400);
            }

            function getReply(msg) {
                var m = msg.toLowerCase();

                if (m.match(/(request|submit|order|new test)/))
                    return "Doctors submit test requests from the Doctor dashboard:\n\n1. Log in as a Doctor\n2. Click 'Create Test Request'\n3. Choose the patient, urgency, and test types\n4. Record the sample barcodes\n5. Submit\n\nThe patient is notified by email.";

                if (m.match(/(hour|open|close|time|weekend|saturday|sunday)/))
                    return "Lab hours:\n\n• Monday – Friday: 07:00 – 18:00\n• Saturday: 08:00 – 13:00\n• Sunday & Public Holidays: Closed\n\nThe online portal is available 24/7.";

                if (m.match(/(location|where|address|find you|directions|map)/))
                    return "We're located at:\n\nNelson Mandela Bay Haematology Diagnostic Laboratories\nGovan Mbeki Avenue, Port Elizabeth, Eastern Cape\n\nSee the map on our homepage for directions.";

                if (m.match(/(how long|turnaround|take|duration|wait)/))
                    return "Turnaround times depend on the test type:\n\n• HIV Rapid — 30 minutes\n• Total Cholesterol — 45 minutes\n• Full Blood Count — 60 minutes\n• COVID-19 PCR — 90 minutes\n• PT/INR — 90 minutes\n• CD4 Count — 120 minutes\n\nUrgent and STAT requests are prioritised.";

                if (m.match(/(test type|what tests|which tests|test list|catalogue|catalog)/))
                    return "We offer a range of haematology tests, including:\n\n• Full Blood Count (FBC)\n• CD4 Count\n• HIV Rapid\n• COVID-19 PCR\n• PT/INR\n• Total Cholesterol\n\nYour doctor will select the appropriate tests.";

                if (m.match(/(result|check result|view result|see result)/))
                    return "To view your results:\n\n1. Log in to the patient portal\n2. Go to 'My Requests'\n3. Requests marked 'Released' have downloadable results\n\nResults are only visible after your doctor releases them.";

                if (m.match(/(password|forgot|login|sign in|reset)/))
                    return "Password help:\n\n• Click 'Login' → 'Forgot password?' to reset by email\n• Passwords must be 8+ characters with one uppercase, one number, and one special character\n• If you're still stuck, contact the laboratory admin.";

                if (m.match(/(barcode|sample|tube|specimen)/))
                    return "Every sample has a barcode tied to your test request.\n\nDoctors record the barcode when they collect the sample, and the lab verifies it on arrival — so nothing gets mixed up.";

                if (m.match(/(hello|hi|hey|good morning|good afternoon)/))
                    return "Hello! How can I help you today?\n\nYou can ask me about submitting test requests, lab hours, test types, results, or account help.";

                if (m.match(/(thank|thanks|cheers)/))
                    return "You're welcome! Anything else I can help with?";

                return "I can help with:\n\n• Submitting a test request\n• Lab hours & location\n• Test types offered\n• Result turnaround times\n• Account & password help\n\nTry asking about one of these topics.";
            }
        })();
    </script>
}