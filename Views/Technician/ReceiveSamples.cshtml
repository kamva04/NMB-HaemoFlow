@model NMB_HLabSys.Models.ViewModels.ReceiveSamplesViewModel
@{
    ViewData["Title"] = "Receive Samples";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-droplet text-primary me-2"></i>Receive Samples</h3>
        <div class="text-muted">Logged in as @Model.TechnicianName</div>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* ============================================================
   STEP 1 � LOOKUP REQUEST
   ============================================================ *@
<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-search me-2"></i>Step 1 � Look up request</div>
    <div class="card-body">
        <form asp-action="LookupRequest" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <label class="form-label">Request number</label>
                <input name="requestNumber" value="@Model.RequestNumber" class="form-control font-monospace" placeholder="e.g. REQ-2026-00123" autofocus />
            </div>
            <div class="col-md-4 d-grid">
                <button class="btn btn-primary"><i class="bi bi-search me-1"></i>Find request</button>
            </div>
        </form>
    </div>
</div>

@if (Model.FoundRequest != null)
{
    @* ============================================================
       FOUND � show request details + verifier + sample table
       ============================================================ *@
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-semibold"><i class="bi bi-clipboard-data me-2"></i>Request Details</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-muted">Request #</dt>
                        <dd class="col-7 font-monospace fw-semibold">@Model.FoundRequest.RequestNumber</dd>

                        <dt class="col-5 text-muted">Patient</dt>
                        <dd class="col-7">
                            @Model.FoundRequest.Patient?.Name @Model.FoundRequest.Patient?.Surname
                            @if (Model.FoundRequest.Patient != null)
                            {
                                <a asp-action="PatientDetails" asp-route-patientId="@Model.FoundRequest.Patient.PatientId"
                                   class="btn btn-sm btn-outline-info ms-2" title="View full patient details">
                                    <i class="bi bi-person-badge"></i>
                                </a>
                            }
                        </dd>
                        <dt class="col-5 text-muted">Requested</dt>
                        <dd class="col-7">@Model.FoundRequest.RequestDate.ToString("dd MMM yyyy HH:mm")</dd>

                        <dt class="col-5 text-muted">Urgency</dt>
                        <dd class="col-7">
                            <span class="badge @(Model.FoundRequest.Urgency == "Stat" ? "bg-danger" : Model.FoundRequest.Urgency == "Urgent" ? "bg-warning text-dark" : "bg-secondary")">
                                @Model.FoundRequest.Urgency
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-header fw-semibold text-primary"><i class="bi bi-upc-scan me-2"></i>Step 2 � Barcode verifier</div>
                <div class="card-body">
                    <p class="text-muted small mb-2">Scan or type each sample barcode below to verify it against this request. Typos are caught before you accept.</p>

                    <div class="input-group mb-2">
                        <span class="input-group-text"><i class="bi bi-upc"></i></span>
                        <input type="text" id="barcodeInput" class="form-control font-monospace" placeholder="Scan / type barcode�" autocomplete="off" />
                        <button type="button" class="btn btn-primary" id="verifyBarcodeBtn">Verify</button>
                    </div>

                    <div id="barcodeResult" class="small"></div>

                    <div class="mt-3">
                        <div class="text-muted small">Verified barcodes</div>
                        <div id="verifiedList" class="d-flex flex-wrap gap-1 mt-1"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold d-flex justify-content-between">
            <span><i class="bi bi-list-check me-2"></i>Samples on this request</span>
            <span class="badge bg-secondary">@Model.Samples.Count</span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover mb-0 align-middle" id="samplesTable">
                <thead class="table-light">
                    <tr>
                        <th>Barcode</th>
                        <th>Sample type</th>
                        <th>Status</th>
                        <th class="text-center">Verified</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Samples)
                    {
                        <tr data-sample-id="@s.SampleId" data-barcode="@s.Barcode" class="@(s.IsReceived ? "table-secondary" : "")">
                            <td>
                                <img src="@Url.Action("BarcodePreview", "Technician", new { value = s.Barcode })"
                                     alt="@s.Barcode" class="barcode-img" loading="lazy" />
                                <div class="font-monospace fw-semibold small mt-1">@s.Barcode</div>
                            </td>
                            <td>@s.SampleTypeName</td>
                            <td>
                                @if (s.IsReceived)
                                {
                                    <span class="badge bg-secondary">Already received</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Awaiting reception</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="verify-tick text-muted">�</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="EditSample" asp-route-sampleId="@s.SampleId" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-action="PrintBarcode" asp-route-sampleId="@s.SampleId"
                                   target="_blank" rel="noopener"
                                   class="btn btn-sm btn-outline-primary ms-1">
                                    <i class="bi bi-printer me-1"></i>Print
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ============================================================
       STEP 3 � Confirm receive OR reject sample
       ============================================================ *@
    <div class="card shadow-sm mb-4 border-success">
        <div class="card-header fw-semibold text-success"><i class="bi bi-check2-circle me-2"></i>Step 3 � Confirm reception</div>
        <div class="card-body">
            <p class="mb-3 text-muted small">By confirming, the request status will move to <strong>Samples Received</strong> and the request will be available for testing.</p>

            <div class="d-flex flex-wrap gap-2">
                <form asp-action="ConfirmReceive" method="post" id="confirmReceiveForm" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="requestId" value="@Model.FoundRequest.RequestId" />
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-check2-circle me-1"></i>Confirm reception
                    </button>
                </form>

                <button type="button" class="btn btn-outline-danger btn-lg"
                        data-bs-toggle="modal" data-bs-target="#rejectSampleModal">
                    <i class="bi bi-x-octagon me-1"></i>Reject sample
                </button>
            </div>
        </div>
    </div>

    @* ============================================================
       REJECT SAMPLE MODAL
       ============================================================ *@
    <div class="modal fade" id="rejectSampleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="RejectSample" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.FoundRequest.RequestId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-x-octagon text-danger me-2"></i>Reject sample</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        The request <strong class="font-monospace">@Model.FoundRequest.RequestNumber</strong>
                        will be marked <strong>Rejected</strong> and the requesting doctor will be notified.
                    </p>
                    <label class="form-label">Reason <span class="text-danger">*</span></label>
                    <textarea name="reason" rows="3" class="form-control"
                              placeholder="e.g. Haemolysed sample � unsuitable for FBC analysis."
                              required maxlength="500"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-octagon me-1"></i>Reject sample
                    </button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script>
            (function () {
                var verifyUrl = '@Url.Action("VerifyBarcode", "Technician")';
                var token = document.querySelector('#confirmReceiveForm input[name="__RequestVerificationToken"]').value;
                var requestId = @Model.FoundRequest.RequestId;

                var verified = new Set();

                var input = document.getElementById('barcodeInput');
                var btn = document.getElementById('verifyBarcodeBtn');
                var resultBox = document.getElementById('barcodeResult');
                var list = document.getElementById('verifiedList');

                function renderVerifiedList() {
                    list.innerHTML = '';
                    verified.forEach(function (bc) {
                        var span = document.createElement('span');
                        span.className = 'badge bg-success';
                        span.textContent = bc;
                        list.appendChild(span);
                    });
                    if (verified.size === 0) {
                        list.innerHTML = '<span class="text-muted small">None yet.</span>';
                    }
                }

                function markTick(sampleId, ok) {
                    var row = document.querySelector('tr[data-sample-id="' + sampleId + '"]');
                    if (!row) return;
                    var tick = row.querySelector('.verify-tick');
                    if (!tick) return;
                    if (ok) {
                        tick.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-5"></i>';
                        row.classList.add('table-success');
                    } else {
                        tick.innerHTML = '<i class="bi bi-x-circle-fill text-danger fs-5"></i>';
                    }
                }

                function showResult(success, message) {
                    resultBox.innerHTML =
                        '<div class="alert ' + (success ? 'alert-success' : 'alert-danger') + ' py-1 px-2 mb-0">' + message + '</div>';
                }

                function verify() {
                    var bc = input.value.trim();
                    if (!bc) return;

                    var body = new URLSearchParams();
                    body.append('requestId', requestId);
                    body.append('barcode', bc);
                    body.append('__RequestVerificationToken', token);

                    fetch(verifyUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success) {
                            showResult(true, '<i class="bi bi-check-circle me-1"></i>' + data.message);
                            verified.add(data.barcode);
                            markTick(data.sampleId, true);
                            input.value = '';
                            input.focus();
                        } else {
                            showResult(false, '<i class="bi bi-exclamation-triangle me-1"></i>' + data.message);
                            if (data.sampleId) markTick(data.sampleId, false);
                        }
                        renderVerifiedList();
                    })
                    .catch(function () {
                        showResult(false, 'Verification failed. Try again.');
                    });
                }

                btn.addEventListener('click', verify);
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); verify(); }
                });

                renderVerifiedList();
                input.focus();
            })();
        </script>
    }
}

@section Styles {
    <style>
        .barcode-img {
            max-height: 55px;
            width: auto;
            background: #fff;
            padding: 3px;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
        }
    </style>
}