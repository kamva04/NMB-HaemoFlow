@model NMB_HLabSys.Models.ViewModels.TestSentBackViewModel
@{
    ViewData["Title"] = "Tests Sent Back";
    string UrgencyBadge(string u) => u switch
    {
        "Stat" => "bg-danger",
        "Urgent" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-arrow-counterclockwise text-danger me-2"></i>Tests Sent Back</h3>
        <div class="text-muted">Results a verifying technician returned to you for review.</div>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

@* Filter *@
<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold"><i class="bi bi-funnel me-2"></i>Filters</div>
    <div class="card-body">
        <form asp-action="TestSentBack" method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Request number</label>
                <input name="requestNumber" value="@Model.RequestNumberFilter" class="form-control" placeholder="Search request…" />
            </div>
            <div class="col-md-6 d-grid d-md-flex gap-2">
                <button class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>Filter</button>
                <a asp-action="TestSentBack" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
            </div>
        </form>
    </div>
</div>

@* Table *@
<div class="card shadow-sm">
    <div class="card-header fw-semibold d-flex justify-content-between">
        <span><i class="bi bi-list-check me-2"></i>Returned for review</span>
        <span class="badge bg-danger">@Model.Rows.Count</span>
    </div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Request #</th>
                    <th>Patient</th>
                    <th>Test</th>
                    <th>Result</th>
                    <th>Sent back</th>
                    <th>By</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="table-warning">
                        <td class="font-monospace fw-semibold">@r.RequestNumber</td>
                        <td>@r.Patient</td>
                        <td>
                            <div class="fw-semibold">@r.TestName</div>
                            <div class="text-muted small">@r.Category</div>
                        </td>
                        <td class="fw-bold @(r.IsAbnormal ? "text-danger" : "")">
                            @(r.ResultValue?.ToString("F2") ?? "—") @r.Units
                        </td>
                        <td class="text-muted small">@(r.SentBackAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td class="text-muted small">@r.SentBackBy</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="SentBackDetails" asp-route-requestTestId="@r.RequestTestId"
                               class="btn btn-sm btn-danger">Review</a>
                            <a asp-action="ResultHistory" asp-route-requestTestId="@r.RequestTestId"
                               class="btn btn-sm btn-outline-secondary">History</a>
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(r.SentBackNote))
                    {
                        <tr class="table-warning">
                            <td colspan="7" class="border-top-0 pt-0">
                                <div class="small fst-italic text-muted ps-2 border-start border-danger border-3">
                                    <strong>Note from verifier:</strong> @r.SentBackNote
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nothing has been sent back to you.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>