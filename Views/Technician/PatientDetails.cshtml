@model NMB_HLabSys.Models.ViewModels.PersonDetailsViewModel
@{
    ViewData["Title"] = "Patient Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-badge text-info me-2"></i>Patient Details</h3>
        <div class="text-muted">Read-only. Visible to assigned technicians.</div>
    </div>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="bi bi-person me-2"></i>Identity</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Full name</dt>
                    <dd class="col-7 fw-semibold">@Model.FullName</dd>

                    <dt class="col-5 text-muted">SA ID number</dt>
                    <dd class="col-7 font-monospace">@(Model.SouthAfricanId ?? "—")</dd>

                    <dt class="col-5 text-muted">Date of birth</dt>
                    <dd class="col-7">@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</dd>

                    <dt class="col-5 text-muted">Age</dt>
                    <dd class="col-7">@(Model.Age?.ToString() ?? "—")</dd>

                    <dt class="col-5 text-muted">Contact number</dt>
                    <dd class="col-7">@(Model.ContactNumber ?? "—")</dd>

                    <dt class="col-5 text-muted">Email</dt>
                    <dd class="col-7">@(Model.Email ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold"><i class="bi bi-clipboard-pulse me-2"></i>Medical history</div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="text-muted small fw-semibold">Conditions</div>
                    @if (Model.MedicalConditions.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var c in Model.MedicalConditions)
                            {
                                <span class="badge bg-danger-subtle text-danger-emphasis border border-danger">@c</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">None recorded.</div>
                    }
                </div>

                <div class="mb-3">
                    <div class="text-muted small fw-semibold">Allergies</div>
                    @if (Model.Allergies.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var a in Model.Allergies)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">@a</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">None recorded.</div>
                    }
                </div>

                <div>
                    <div class="text-muted small fw-semibold">Medications</div>
                    @if (Model.Medications.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var m in Model.Medications)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info">@m</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">None recorded.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>