@model NMB_HLabSys.Models.ViewModels.TechnicianCancelRequestViewModel
@{
    ViewData["Title"] = "Cancel Test Request";
}
<div class="row justify-content-center"><div class="col-lg-8">
<div class="card shadow-sm mb-4"><div class="card-header bg-danger text-white"><h5 class="mb-0"><i class="bi bi-x-circle me-2"></i>Cancel Test Request</h5></div><div class="card-body p-4">
<p class="text-muted">Laboratory cancellation is permitted only while a request is <strong>Submitted</strong>, <strong>Samples Received</strong>, or <strong>In Progress</strong>.</p>
<form asp-action="LookupRequestForCancel" method="post">@Html.AntiForgeryToken()<div class="input-group"><input asp-for="RequestNumber" class="form-control" placeholder="Request number" /><button class="btn btn-primary">Look Up</button></div><span asp-validation-for="RequestNumber" class="text-danger small"></span></form>
</div></div>
@if(Model.FoundRequest != null)
{
<div class="card shadow-sm"><div class="card-header fw-semibold">Request @Model.FoundRequest.RequestNumber</div><div class="card-body">
<div class="row g-3 mb-4"><div class="col-md-6"><span class="text-muted small">Patient</span><div>@Model.FoundRequest.Patient?.Name @Model.FoundRequest.Patient?.Surname</div></div><div class="col-md-3"><span class="text-muted small">Status</span><div><span class="badge bg-secondary">@Model.FoundRequest.Status</span></div></div><div class="col-md-3"><span class="text-muted small">Urgency</span><div>@Model.FoundRequest.Urgency</div></div></div>
@if(Model.CanCancel)
{
<form asp-action="CancelRequest" method="post">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@Model.FoundRequest.RequestId" /><div class="mb-3"><label asp-for="Reason" class="form-label fw-semibold"></label><textarea asp-for="Reason" class="form-control" rows="4" placeholder="Explain the laboratory reason for cancellation…"></textarea><span asp-validation-for="Reason" class="text-danger small"></span></div><button class="btn btn-danger" onclick="return confirm('Cancel this test request?');"><i class="bi bi-x-circle me-1"></i>Cancel Request</button></form>
}
else { <div class="alert alert-warning mb-0"><i class="bi bi-lock me-2"></i>@Model.BlockedReason</div> }
</div></div>
}
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
