@model NMB_HLabSys.Models.ViewModels.TechnicianStatesViewModel
@{
    ViewData["Title"] = "My States";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-bar-chart-steps text-primary me-2"></i>My States</h3>
        <div class="text-muted">Summary of your workload and performance.</div>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

@* Top KPI cards *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-body">
                <div class="text-muted small">Total assigned</div>
                <div class="display-6 fw-bold text-primary">@Model.TotalAssigned</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-success h-100">
            <div class="card-body">
                <div class="text-muted small">Verified today</div>
                <div class="display-6 fw-bold text-success">@Model.VerifiedToday</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-info h-100">
            <div class="card-body">
                <div class="text-muted small">Completed today</div>
                <div class="display-6 fw-bold text-info">@Model.CompletedToday</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-danger h-100">
            <div class="card-body">
                <div class="text-muted small">Overdue right now</div>
                <div class="display-6 fw-bold text-danger">@Model.OverdueCount</div>
            </div>
        </div>
    </div>
</div>

@* Status breakdown + performance side by side *@
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="bi bi-pie-chart me-2"></i>Breakdown by status</div>
            <div class="card-body p-0 table-responsive">
                <table class="table mb-0 align-middle">
                    <thead class="table-light">
                        <tr><th>Status</th><th class="text-center">Count</th><th class="text-end">Share</th></tr>
                    </thead>
                    <tbody>
                        @{
                            int total = Math.Max(Model.TotalAssigned, 1);
                            void Row(string label, int count, string badgeClass)
                            {
                                var pct = (int)Math.Round((double)count * 100 / total);
                                <tr>
                                    <td><span class="badge @badgeClass">@label</span></td>
                                    <td class="text-center fw-bold">@count</td>
                                    <td class="text-end text-muted small">@pct %</td>
                                </tr>
                            }
                        }
                        @{
                            Row("Submitted", Model.Submitted, "bg-secondary");
                        }
                        @{
                            Row("In Progress", Model.InProgress, "bg-primary");
                        }
                        @{
                            Row("Completed", Model.Completed, "bg-info text-dark");
                        }
                        @{
                            Row("Verified", Model.Verified, "bg-success");
                        }
                        @{
                            Row("To Be Reviewed", Model.ToBeReviewed, "bg-warning text-dark");
                        }
                        @{
                            Row("Cancelled", Model.Cancelled, "bg-dark");
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header fw-semibold"><i class="bi bi-speedometer me-2"></i>Performance</div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">Average turnaround</span>
                    <span class="fs-5 fw-bold">
                        @(Model.AverageTurnaroundMinutes > 0
                                                ? TimeSpan.FromMinutes(Model.AverageTurnaroundMinutes).ToString(@"hh\:mm")
                                                : "—")
                    </span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">Abnormal results</span>
                    <span class="fs-5 fw-bold text-danger">@Model.AbnormalCount</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">Currently overdue</span>
                    <span class="fs-5 fw-bold text-danger">@Model.OverdueCount</span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body text-center">
                <a asp-action="Reports" class="btn btn-outline-primary w-100">
                    <i class="bi bi-file-earmark-pdf me-1"></i>Generate PDF Report
                </a>
                <a asp-action="WorkBench" class="btn btn-outline-secondary w-100 mt-2">
                    <i class="bi bi-columns-gap me-1"></i>Open Work Bench
                </a>
            </div>
        </div>
    </div>
</div>