@model NMB_HLabSys.Models.ViewModels.PersonDetailsViewModel
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-vcard text-primary me-2"></i>Doctor Details</h3>
        <div class="text-muted">Read-only. Requesting doctor on this request.</div>
    </div>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold"><i class="bi bi-person me-2"></i>Identity</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-md-3 text-muted">Full name</dt>
            <dd class="col-md-9 fw-semibold">@Model.FullName</dd>

            <dt class="col-md-3 text-muted">HPCSA number</dt>
            <dd class="col-md-9 font-monospace">@(Model.HpcsaNumber ?? "—")</dd>

            <dt class="col-md-3 text-muted">Contact number</dt>
            <dd class="col-md-9">@(Model.ContactNumber ?? "—")</dd>

            <dt class="col-md-3 text-muted">Email</dt>
            <dd class="col-md-9">@(Model.Email ?? "—")</dd>
        </dl>
    </div>
</div>