@model NMB_HLabSys.Models.ViewModels.ReportStockProblemViewModel
@{
    ViewData["Title"] = "Report Stock Problem";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-hero mb-4">
    <div class="page-hero-body">
        <h1 class="page-title">
            <i class="bi bi-exclamation-triangle text-warning me-2"></i>Report a Stock Problem
        </h1>
        <p class="page-subtitle mb-0">
            Flag damaged, expired, or missing consumables so the Lab Manager can investigate and resolve.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">
                <i class="bi bi-clipboard-x me-2"></i>Problem details
            </div>
            <div class="card-body p-4">
                <form asp-action="ReportStockProblem" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="ConsumableId" class="form-label">Consumable</label>
                        <select asp-for="ConsumableId" class="form-select" required>
                            <option value="">— Select consumable —</option>
                            @foreach (var c in Model.AvailableConsumables)
                            {
                                <option value="@c.ConsumableId">
                                    @c.ConsumableName — on hand: @c.QuantityOnHand
                                </option>
                            }
                        </select>
                        <span asp-validation-for="ConsumableId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProblemType" class="form-label">Problem type</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var opt in new[] {
                                ("Damaged", "bi-shield-exclamation", "text-danger"),
                                ("Expired", "bi-calendar-x", "text-warning"),
                                ("Missing", "bi-question-circle", "text-secondary")
                            })
                            {
                                <label class="problem-type-pill @opt.Item3">
                                    <input type="radio" name="ProblemType" value="@opt.Item1"
                                           @(Model.ProblemType == opt.Item1 ? "checked" : "") />
                                    <i class="bi @opt.Item2 me-1"></i>@opt.Item1
                                </label>
                            }
                        </div>
                        <span asp-validation-for="ProblemType" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" rows="4" class="form-control"
                                  placeholder="Describe what you found (e.g. 3 boxes of reagent A expired on 12 Nov; seal broken on 2 units of reagent B)."
                                  maxlength="500"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                        <div class="form-text">Minimum 5 characters. Be specific — this helps the manager investigate.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send me-1"></i>Submit report
                        </button>
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">
                <i class="bi bi-info-circle me-2"></i>What to report
            </div>
            <div class="card-body p-4">
                <ul class="list-unstyled small mb-0">
                    <li class="mb-3">
                        <span class="badge bg-danger-subtle text-danger-emphasis me-2">Damaged</span>
                        Broken packaging, cracked bottles, damaged seals.
                    </li>
                    <li class="mb-3">
                        <span class="badge bg-warning-subtle text-warning-emphasis me-2">Expired</span>
                        Past its labelled expiry date — should not be used.
                    </li>
                    <li>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis me-2">Missing</span>
                        Cannot be located in store — possibly miscounted or misplaced.
                    </li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header fw-semibold">
                <i class="bi bi-arrow-right-circle me-2"></i>What happens next
            </div>
            <div class="card-body p-4 small">
                <ol class="ps-3 mb-0">
                    <li class="mb-2">Your report is sent to the <strong>Lab Manager</strong> instantly.</li>
                    <li class="mb-2">The manager reviews and can mark it <strong>Investigating</strong> or <strong>Resolved</strong>.</li>
                    <li>You'll receive a notification when the status changes.</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .problem-type-pill {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .5rem .9rem;
            border: 1px solid #dee2e6;
            border-radius: .6rem;
            background: #fff;
            cursor: pointer;
            font-size: .9rem;
            font-weight: 500;
            transition: .15s;
        }
        .problem-type-pill:hover { background: #f8f9fa; }
        .problem-type-pill input { display: none; }
        .problem-type-pill:has(input:checked) {
            border-color: #073b82;
            background: #e7f0ff;
            color: #073b82;
            box-shadow: 0 0 0 2px rgba(13, 110, 253, .15);
        }
    </style>
}