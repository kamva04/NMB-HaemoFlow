@model NMB_HLabSys.Models.ViewModels.TechnicianReportViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Technician Reports</h3>
        <div class="text-muted">Generate a PDF of tests you've completed within a date range.</div>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold"><i class="bi bi-calendar-range me-2"></i>Report parameters</div>
            <div class="card-body">

                <form asp-action="Reports" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger small"></div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FromDate" class="form-label"></label>
                            <input asp-for="FromDate" type="date" class="form-control" />
                            <span asp-validation-for="FromDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ToDate" class="form-label"></label>
                            <input asp-for="ToDate" type="date" class="form-control" />
                            <span asp-validation-for="ToDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        The report includes all tests you have <strong>completed</strong> (status Completed or Verified)
                        in the selected period, grouped by test category.
                    </div>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Generate PDF
                    </button>

                    <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                </form>

            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header fw-semibold"><i class="bi bi-lightbulb me-2"></i>Quick ranges</div>
            <div class="card-body d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary quick-range" data-days="7">Last 7 days</button>
                <button type="button" class="btn btn-sm btn-outline-primary quick-range" data-days="30">Last 30 days</button>
                <button type="button" class="btn btn-sm btn-outline-primary quick-range" data-days="90">Last 90 days</button>
                <button type="button" class="btn btn-sm btn-outline-primary quick-range" data-days="365">Last 12 months</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var fromInput = document.getElementById('FromDate');
            var toInput = document.getElementById('ToDate');

            document.querySelectorAll('.quick-range').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var days = parseInt(btn.getAttribute('data-days'), 10);
                    var today = new Date();
                    var from = new Date();
                    from.setDate(today.getDate() - days);

                    if (fromInput) fromInput.value = from.toISOString().slice(0, 10);
                    if (toInput) toInput.value = today.toISOString().slice(0, 10);
                });
            });
        })();
    </script>
}