@model NMB_HLabSys.Models.ViewModels.PersonDetailsViewModel
@{
    ViewData["Title"] = "Technician Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-gear text-success me-2"></i>Technician Details</h3>
        <div class="text-muted">Read-only. Lab staff information.</div>
    </div>
    <a href="javascript:history.back()" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="bi bi-person me-2"></i>Identity</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Full name</dt>
                    <dd class="col-7 fw-semibold">@Model.FullName</dd>

                    <dt class="col-5 text-muted">Employee number</dt>
                    <dd class="col-7 font-monospace">@(Model.EmployeeNumber ?? "—")</dd>

                    <dt class="col-5 text-muted">SA ID number</dt>
                    <dd class="col-7 font-monospace">@(Model.SouthAfricanId ?? "—")</dd>

                    <dt class="col-5 text-muted">Contact number</dt>
                    <dd class="col-7">@(Model.ContactNumber ?? "—")</dd>

                    <dt class="col-5 text-muted">Email</dt>
                    <dd class="col-7">@(Model.Email ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold"><i class="bi bi-clipboard-check me-2"></i>Assigned test types</div>
            <div class="card-body">
                @if (Model.AssignedTestTypes.Any())
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var t in Model.AssignedTestTypes)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis border border-success">@t</span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted fst-italic">No test types assigned yet.</div>
                }
            </div>
        </div>
    </div>
</div>