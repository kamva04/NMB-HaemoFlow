@model NMB_HLabSys.Models.ViewModels.UsageHistoryViewModel
@{
    ViewData["Title"] = "Usage History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-hero">
    <div class="page-hero-body">
        <h1 class="page-title">Usage History</h1>
        <p class="page-subtitle">Consumables automatically deducted each time you start a test.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="metric-card"><div class="metric-label">Test instances</div><div class="metric-value">@Model.TotalTests</div></div></div>
    <div class="col-md-4"><div class="metric-card"><div class="metric-label">Units consumed</div><div class="metric-value">@Model.TotalUnitsConsumed</div></div></div>
    <div class="col-md-4"><div class="metric-card"><div class="metric-label">Rows shown</div><div class="metric-value">@Model.Rows.Count</div></div></div>
</div>

<div class="card soft-card">
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-clock-history display-5 d-block mb-3"></i>
                No consumable usage recorded yet. Start a test to see entries here.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">When</th>
                            <th>Request #</th>
                            <th>Test</th>
                            <th>Consumable</th>
                            <th class="text-center">Qty Used</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="ps-4 small text-muted">@r.UsedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td class="fw-semibold">@r.RequestNumber</td>
                                <td>@r.TestTypeName</td>
                                <td>@r.ConsumableName</td>
                                <td class="text-center"><span class="badge bg-primary-subtle text-primary-emphasis">−@r.QuantityUsed</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>